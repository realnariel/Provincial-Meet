    .medal-text-silver { color: #64748B; font-weight: 800; text-shadow: 0 1px 2px rgba(0,0,0,0.1); }
    .medal-text-bronze { color: #EA580C; font-weight: 800; text-shadow: 0 1px 2px rgba(0,0,0,0.1); }

