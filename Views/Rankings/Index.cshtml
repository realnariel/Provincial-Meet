        height: clamp(28px, 5vw, 44px);
        margin-top: .35rem;
        border-radius: 0 0 12px 12px;
        pointer-events: none;
        background:
            linear-gradient(35deg, #073d28 0 25%, #397447 25% 32%, #c8a354 32% 34%, transparent 34%) left bottom / 28% 100% no-repeat,
            linear-gradient(-35deg, #073d28 0 25%, #397447 25% 32%, #c8a354 32% 34%, transparent 34%) right bottom / 28% 100% no-repeat,
            radial-gradient(#39744766 1px, transparent 1.6px) 0 0 / 7px 7px;
        mask-image: linear-gradient(to right, #000 8%, transparent 42%, transparent 58%, #000 92%);
    }
    .tally-board .division-filters { margin-bottom: .5rem; }
    .tally-mottos { display: none; }
    .tally-hero .meet-art { height: var(--tally-art-height, 110px); width: 100%; margin: 0; }
    .tally-district { font-size: clamp(.9rem, 1.5vw, 1.25rem); }
    .tally-event { font-size: clamp(1.25rem, 2.5vw, 2rem); margin: .2rem 0; }
    .tally-event span { display: inline; font-size: 1em; margin-left: .2em; }
    .tally-areas { font-size: .65rem; margin: .4rem 0 .6rem; letter-spacing: .18em; }
    .tally-title { font-size: clamp(1.6rem, 3vw, 2.5rem); }
    .rank-badge { display: inline-block; position: relative; width: 2.35rem; height: 2.1rem; vertical-align: middle; color: #af791d; }
    .rank-badge svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 1px 1px #0005); }
    .rank-badge span { position: relative; display: grid; place-items: center; height: 100%; font: 900 1.4rem/1 Georgia, serif; color: #fff4cf; text-shadow: 0 1px 2px #4b2c04; }
    .rank-badge.rank-2 { color: #85929f; }
    .rank-badge.rank-2 span { color: #fff; text-shadow: 0 1px 2px #293644; }
    .rank-badge.rank-3 { color: #a05a32; }
    .rank-badge.rank-3 span { color: #ffebd5; }
    @@media (max-width: 767.98px) {
        .tally-hero .meet-art { height: var(--tally-art-height, 75px); }
        .rank-badge { width: 1.85rem; height: 1.6rem; }
        .rank-badge span { font-size: 1.1rem; }
        .tally-asof { margin: .5rem 0; }
    }
    .medal-table tbody td { font-size: 1.6rem !important; font-variant-numeric: tabular-nums; padding-left: .3rem; padding-right: .3rem; }
    .medal-table .school-name-text { font-size: 1.25rem !important; letter-spacing: 0; }
    @@media (max-width: 768px) {
        .medal-table tbody td { font-size: clamp(1rem, 4vw, 1.3rem) !important; padding-left: 2px !important; padding-right: 2px !important; }
        .medal-table .school-name-text { font-size: clamp(.8rem, 3.2vw, 1.05rem) !important; }
        .medal-table thead th { padding-left: 2px !important; padding-right: 2px !important; font-size: .65rem !important; letter-spacing: 0; }
    }
    @@media (max-width: 991.98px) and (orientation: portrait) {
        .tally-board { min-height: var(--tally-available-height, auto); }
        .tally-board > .flex-grow-1 { flex-grow: 0 !important; }
        .tally-board::after { flex-grow: 1; min-height: 28px; }
    }
    @@media (max-width: 991.98px) and (orientation: landscape) {
        .rankings-page { max-width: none; padding-top: .5rem !important; }
        .rankings-page > .row { --bs-gutter-x: .75rem; --bs-gutter-y: .5rem; }
        .rankings-page .tally-board { width: 62%; padding: .5rem; }
        .rankings-page .tally-results { width: 38%; min-width: 0; }
        .tally-board .division-filters { gap: .2rem; margin-bottom: .25rem; }
        .tally-board .filter-btn { font-size: .55rem; padding: .4rem .1rem; }
        .tally-district { font-size: .8rem; }
        .tally-event { font-size: 1.1rem; }
        .tally-areas { font-size: .5rem; margin: .2rem 0; }
        .tally-title { font-size: 1.2rem; padding: .3rem; }
        .tally-asof { font-size: .55rem; margin: .3rem 0; }
        .medal-table thead th { font-size: .55rem !important; padding: .35rem 1px !important; letter-spacing: 0; }
        .medal-table tbody td { font-size: 1rem !important; padding: .35rem 1px !important; }
        .medal-table .school-name-text { font-size: .72rem !important; }
        .medal-coin { font-size: .8rem; }
        .rank-badge { width: 1.6rem; height: 1.4rem; }
