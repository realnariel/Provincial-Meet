@model IEnumerable<ProvMeet.Models.MedalTally>
@{
    ViewData["Title"] = "Overall Team Rankings";
    var recentResults = ViewBag.RecentResults as List<ProvMeet.Models.Event> ?? new List<ProvMeet.Models.Event>();
    var teamNames = ViewBag.Teams as Dictionary<int, string> ?? new Dictionary<int, string>();

    string[] WinnerNames(string? names) => (names ?? "").Split(
        new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    
    
    // Core Philippine Standard Time (PST - UTC+8) Utility
    string FormatToPst(DateTime? dt, string format = "MMM dd, yyyy • h:mm tt") {
        if (!dt.HasValue) return "N/A";
        
        DateTime utcDateTime;
        if (dt.Value.Kind == DateTimeKind.Utc) {
            utcDateTime = dt.Value;
        } else if (dt.Value.Kind == DateTimeKind.Local) {
            utcDateTime = dt.Value.ToUniversalTime();
        } else {
            utcDateTime = DateTime.SpecifyKind(dt.Value, DateTimeKind.Utc);
        }
            
        return utcDateTime.AddHours(8).ToString(format);
    }

    DateTime? lastUpdateUtc = recentResults.Any() ? recentResults.Max(r => r.UpdatedAt) : null;
    string lastUpdatedString = lastUpdateUtc.HasValue ? FormatToPst(lastUpdateUtc.Value, "MMMM d, yyyy | h:mm tt") : FormatToPst(DateTime.UtcNow, "MMMM d, yyyy | h:mm tt");

    string GetHouseText(string name) {
        if(string.IsNullOrEmpty(name)) return "var(--cc-primary, #123F2D)";
        if(name.Contains("Loon", StringComparison.OrdinalIgnoreCase)) return "#C8A354"; 
        if(name.Contains("Calape", StringComparison.OrdinalIgnoreCase)) return "#123F2D"; 
        if(name.Contains("Tubigon", StringComparison.OrdinalIgnoreCase)) return "#397447"; 
        return "var(--cc-primary, #123F2D)";
    }

    // Build a lookup dictionary for acronyms based on the Model
    var acronymMap = new Dictionary<string, string>();
    foreach (var tally in Model)
    {
        if (tally.Team != null && !string.IsNullOrEmpty(tally.Team.Name))
        {
            acronymMap[tally.Team.Name] = !string.IsNullOrEmpty(tally.Team.Acronym) ? tally.Team.Acronym : tally.Team.Name;
        }
    }

    // Helper to fetch the acronym for the Recent Updates feed
    string GetTeamDisplayName(int teamId)
    {
        if (!teamNames.ContainsKey(teamId)) return "Unknown Team";
        string fullName = teamNames[teamId];
        return acronymMap.ContainsKey(fullName) ? acronymMap[fullName] : fullName;
    }

    // Pre-sort the standings by Gold, Silver, Bronze, and then Alphabetically by Team Name for ties (Secondary/Elementary)
    var sortedStandings = Model
        .OrderByDescending(t => t.Gold)
        .ThenByDescending(t => t.Silver)
        .ThenByDescending(t => t.Bronze)
        .ThenBy(t => t.Team?.Name ?? "")
        .ToList();

    // Overall standings combine each team's Elementary and Secondary results.
    var overallStandings = Model
        .Where(t => t.Division == "Elementary" || t.Division == "Secondary")
        .GroupBy(t => t.Team?.Name.Trim() ?? string.Empty)
        .Select(g => new {
            Municipality = g.Key,
            Gold = g.Sum(x => x.Gold),
            Silver = g.Sum(x => x.Silver),
            Bronze = g.Sum(x => x.Bronze),
            Total = g.Sum(x => x.Gold + x.Silver + x.Bronze)
        })
        .OrderByDescending(x => x.Gold)
        .ThenByDescending(x => x.Silver)
        .ThenByDescending(x => x.Bronze)
        .ThenBy(x => x.Municipality)
        .ToList();
}

<style>
    /* ========================================== */
    /* MASTER OPACITY & COLOR CONTROL             */
    :root {
        --card-opacity: 1.0; 
    }
    /* ========================================== */

    body {
        background-color: var(--cc-background) !important; 
    }

    /* Clean Page Header matching Events page */
    .page-header {
        color: var(--cc-primary, #123F2D);
        border-bottom: 3px solid var(--cc-gold, #C8A354);
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }
    .page-header h1 {
        color: var(--cc-primary, #123F2D);
    }

    /* Animated Gradient Keyframes (Navy Blue <-> Burgundy) */
    @@keyframes gradientMove {
