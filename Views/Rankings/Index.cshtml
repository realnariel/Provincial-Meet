    .tally-asof i { margin-right: .3rem; }
    .medal-table tbody tr[data-rank="1"] td { background: #f5db8c; }
    .medal-table tbody tr[data-rank="2"] td { background: #dce3ea; }
    .medal-table tbody tr[data-rank="3"] td { background: #edbd99; }
    .medal-table .school-name-text { color: #063d2a !important; }
    .medal-table .medal-text-gold { color: #795009; }
    .medal-table .medal-text-silver { color: #274259; }
    .medal-table .medal-text-bronze { color: #773419; }
