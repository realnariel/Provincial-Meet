        .tally-results .feed-winners { text-align: left; }
    }
</style>

<div class="container py-4 py-md-5 rankings-page">
    
    <div class="row g-4 align-items-stretch">
        
        <!-- Main Standings Board Section -->
        <div class="col-12 col-lg-8 d-flex flex-column tally-board">
            
            <!-- Division & Overall Selection Tabs (Rearranged Succession: Overall -> Elementary -> Secondary) -->
            <div class="division-filters">
                <button class="filter-btn active-filter" onclick="setDivisionFilter('Overall', this)">Overall</button>
                <button class="filter-btn" onclick="setDivisionFilter('Secondary', this)">Secondary</button>
                <button class="filter-btn" onclick="setDivisionFilter('Elementary', this)">Elementary</button>
                <button class="filter-btn" onclick="setDivisionFilter('Paragames', this)">Paragames</button>
            </div>

            <header class="tally-hero">
                <div class="tally-mottos"><span>One Province<br />One Spirit<br />Brighter Futures</span><span>DISCIPLINE<br />SPORTSMANSHIP<br />EXCELLENCE<br />UNITY</span></div>
                <partial name="~/Views/Home/_MeetHeroArt.cshtml" />
                <p class="tally-district">Province of Bohol</p>
                <h1 class="tally-event">ATHLETIC MEET <span>2026</span></h1>
                <p class="tally-areas">ELEMENTARY · SECONDARY · PARAGAMES</p>
            </header>
            <h2 class="tally-title"><i class="bi bi-award" aria-hidden="true"></i> MEDAL TALLY <i class="bi bi-award" aria-hidden="true"></i></h2>
            <p class="tally-asof"><i class="bi bi-clock-fill" aria-hidden="true"></i> As of @lastUpdatedString</p>

            <div class="flex-grow-1 p-0 bg-transparent border-0 shadow-none">
                @if(!Model.Any())
                {
                    <div class="text-center py-5 rounded shadow-sm" style="background: rgba(255,255,255,0.4); backdrop-filter: blur(10px);">
                        <i class="bi bi-trophy" style="font-size: 3rem; color: var(--cc-text-muted);"></i>
                        <p class="mt-3 text-muted fw-bold">No recorded entries yet. The games have not started.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive p-0">
                        <table class="minimalist-table medal-table w-100 mb-0" id="rankingsTable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 12%;">Rank</th>
                                    <th style="width: 24%;">Team</th>
                                    <th class="text-center medal-header medal-header-gold" style="width: 16%;"><span class="medal-coin">🥇</span> G</th>
                                    <th class="text-center medal-header medal-header-silver" style="width: 16%;"><span class="medal-coin">🥈</span> S</th>
                                    <th class="text-center medal-header medal-header-bronze" style="width: 16%;"><span class="medal-coin">🥉</span> B</th>
                                    <th class="text-center" style="width: 16%;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Secondary & Elementary Rows -->
                                @foreach (var tally in sortedStandings)
                                {
                                    int totalMedals = tally.Gold + tally.Silver + tally.Bronze;
                                    string fullTeamName = tally.Team?.Name ?? "Unknown Team";
                                    string displaySchoolName = !string.IsNullOrEmpty(tally.Team?.Acronym) ? tally.Team.Acronym : fullTeamName;
                                    string teamColor = GetHouseText(fullTeamName);
                                    string rowDivision = tally.Division;

                                    <tr class="ranking-row" data-division="@rowDivision" data-gold="@tally.Gold" data-silver="@tally.Silver" data-bronze="@tally.Bronze">
                                        <td class="text-center fw-bold rank-cell" style="color: var(--cc-primary); font-size: 1rem;"></td>
                                        <td>
                                            <span class="fw-bold school-name-text" data-default-color="@teamColor" style="color: @teamColor; font-size: 0.95rem;">
                                                @displaySchoolName
                                            </span>
                                        </td>
                                        <td class="text-center fw-bold medal-text-gold">@tally.Gold</td>
                                        <td class="text-center fw-bold medal-text-silver">@tally.Silver</td>
                                        <td class="text-center fw-bold medal-text-bronze">@tally.Bronze</td>
                                        <td class="text-center fw-bold" style="color: var(--cc-primary); font-size: 0.95rem;">@totalMedals</td>
                                    </tr>
                                }

                                <!-- Overall Combined Municipality Rows -->
                                @foreach (var overall in overallStandings)
                                {
                                    int totalMedals = overall.Total;
                                    string teamColor = GetHouseText(overall.Municipality);
                                    string displayAreaName = acronymMap.ContainsKey(overall.Municipality) ? acronymMap[overall.Municipality] : overall.Municipality;

                                    <tr class="ranking-row" data-division="Overall" data-gold="@overall.Gold" data-silver="@overall.Silver" data-bronze="@overall.Bronze">
                                        <td class="text-center fw-bold rank-cell" style="color: var(--cc-primary); font-size: 1rem;"></td>
                                        <td>
                                            <span class="fw-bold school-name-text" data-default-color="@teamColor" style="color: @teamColor; font-size: 0.95rem;">
                                                @displayAreaName
                                            </span>
                                        </td>
                                        <td class="text-center fw-bold medal-text-gold">@overall.Gold</td>
                                        <td class="text-center fw-bold medal-text-silver">@overall.Silver</td>
                                        <td class="text-center fw-bold medal-text-bronze">@overall.Bronze</td>
                                        <td class="text-center fw-bold" style="color: var(--cc-primary); font-size: 0.95rem;">@totalMedals</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        
                        <div id="noRankingsRow" class="text-center py-5 rounded mt-0" style="display: none; background: rgba(255,255,255,0.4); backdrop-filter: blur(10px);">
                            <p class="mb-0 text-muted fw-bold">No ranking statistics recorded for this category yet.</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Updates Feed Section (Transparent Container & Pop-out Cards) -->
        <div class="col-12 col-lg-4 tally-results">
            <div class="updates-sidebar-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0 fw-bold" style="font-family: var(--font-body); color: var(--cc-primary);">Results</h4>
                    <span class="badge bg-light text-primary border rounded-pill px-2 py-1" style="font-size: 0.7rem; font-weight: 700;">Latest Results</span>
                </div>
                
                <div style="max-height: 550px; overflow-y: auto; padding-right: 5px;">
                    @if (!recentResults.Any())
                    {
                        <div class="text-center py-4 text-muted border border-dashed rounded bg-light">
                            <small>Awaiting news from ongoing match events...</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var game in recentResults)
                        {
                            <!-- Clickable Event Card -> Routes to SubmitResults with returnUrl query parameter -->
                            <a asp-controller="Events" asp-action="SubmitResults" asp-route-id="@game.Id" asp-route-returnUrl="@Url.Action("Index", "Rankings")" class="feed-item">
                                <div class="d-flex justify-content-between align-items-start mb-1 gap-2">
                                    <h6 class="feed-title mb-0">@game.Title</h6>
                                    <small class="feed-time text-nowrap">@FormatToPst(game.UpdatedAt, "MMM dd, yyyy • h:mm tt")</small>
                                </div>
                                <div class="feed-div" aria-label="Sport and division">
                                    <span class="feed-sport"><i class="bi bi-trophy-fill me-1" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(game.SportName) ? "Sport not specified" : game.SportName)</span>
                                    <span class="feed-meta-separator" aria-hidden="true">•</span>
                                    <span>@(game.Division ?? "Secondary")</span>
                                </div>
                                
                                <div class="d-flex flex-column gap-1">
                                    @if(game.GoldTeamId.HasValue && teamNames.ContainsKey(game.GoldTeamId.Value))
                                    {
                                        string goldIdentifier = GetTeamDisplayName(game.GoldTeamId.Value);
                                        <div class="feed-medal-row">
                                            <div class="medal-text"><span class="medal-icon">🥇</span> <span class="fw-bold">@goldIdentifier</span><span class="ms-1 opacity-75" style="font-size: 0.75rem;">(Gold)</span></div>
                                            <div class="feed-winners" aria-label="Gold winners">
                                                @foreach (var name in WinnerNames(game.GoldWinnerName))
                                                {
                                                    <span class="feed-winner-name">@name</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if(game.SilverTeamId.HasValue && teamNames.ContainsKey(game.SilverTeamId.Value))
                                    {
                                        string silverIdentifier = GetTeamDisplayName(game.SilverTeamId.Value);
                                        <div class="feed-medal-row">
                                            <div class="medal-text"><span class="medal-icon">🥈</span> <span class="fw-bold">@silverIdentifier</span><span class="ms-1 opacity-75" style="font-size: 0.75rem;">(Silver)</span></div>
                                            <div class="feed-winners" aria-label="Silver winners">
                                                @foreach (var name in WinnerNames(game.SilverWinnerName))
                                                {
                                                    <span class="feed-winner-name">@name</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if(game.BronzeTeamId.HasValue && teamNames.ContainsKey(game.BronzeTeamId.Value))
                                    {
                                        string bronzeIdentifier = GetTeamDisplayName(game.BronzeTeamId.Value);
                                        <div class="feed-medal-row">
                                            <div class="medal-text"><span class="medal-icon">🥉</span> <span class="fw-bold">@bronzeIdentifier</span><span class="ms-1 opacity-75" style="font-size: 0.75rem;">(Bronze)</span></div>
                                            <div class="feed-winners" aria-label="Bronze winners">
                                                @foreach (var name in WinnerNames(game.BronzeWinnerName))
                                                {
                                                    <span class="feed-winner-name">@name</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Updated Division Rotation Order: Overall -> Secondary -> Elementary -> Paragames
    const divisionsList = ['Overall', 'Secondary', 'Elementary', 'Paragames'];
    let currentDivIndex = 0;
    let autoTimer = null;
    let idleTimer = null;
    let isAutoRotating = true;

    $(document).ready(function() {
        let savedDivision = 'Overall';
        try {
            const stored = sessionStorage.getItem('prov_rankings_division');
            if (stored && divisionsList.includes(stored)) savedDivision = stored;
        } catch (e) {}

        // Initialize state
        currentDivIndex = divisionsList.indexOf(savedDivision);
        updateActiveButton(savedDivision);
        applyDivisionFilter(savedDivision);
        
        // Start automatic rotation immediately on page load
        startAutoRotation();

        // Reset the idle timer on user interactions
        $(document).on('mousemove keypress touchstart', function() {
            if (!isAutoRotating) {
                resetIdleTimer();
            }
        });
    });

    function updateActiveButton(division) {
        $('.division-filters .filter-btn').removeClass('active-filter');
        $('.division-filters .filter-btn').each(function() {
            if ($(this).text().trim().toLowerCase() === division.toLowerCase()) {
                $(this).addClass('active-filter');
            }
        });
    }

    function setDivisionFilter(division, btnElement) {
        isAutoRotating = false;
        clearInterval(autoTimer);
        
        currentDivIndex = divisionsList.findIndex(d => d.toLowerCase() === division.toLowerCase());
        
        updateActiveButton(division);
        
        try {
            sessionStorage.setItem('prov_rankings_division', division);
        } catch (e) {}
        
        applyDivisionFilter(division);
        
        resetIdleTimer();
    }

    function startAutoRotation() {
        isAutoRotating = true;
        clearInterval(autoTimer);
        autoTimer = setInterval(function() {
            currentDivIndex++;
            
            // Check if we have surpassed the last division in the list
            if (currentDivIndex >= divisionsList.length) {
                // We've shown all tabs, now reset state to 'Overall' and reload to fetch latest data
                try {
                    sessionStorage.setItem('prov_rankings_division', 'Overall');
                } catch (e) {}
                
                // Refresh the page
                window.location.reload();
                return; // Stop execution here
            }

            let nextDiv = divisionsList[currentDivIndex];
            
            updateActiveButton(nextDiv);
            applyDivisionFilter(nextDiv);
        }, 10000); // 10 seconds per tab
    }

    function resetIdleTimer() {
        clearTimeout(idleTimer);
        idleTimer = setTimeout(function() {
            startAutoRotation();
        }, 15000); 
    }

    function applyDivisionFilter(division) {
        let visibleCount = 0;
        let runningCount = 1;
        let displayRank = 1;
        
        let prevGold = -1;
        let prevSilver = -1;
        let prevBronze = -1;

        $('.ranking-row').each(function() {
            let rowDivision = $(this).data('division') ? $(this).data('division').toString().trim().toLowerCase() : '';
            let targetDivision = division.toString().trim().toLowerCase();

            if (rowDivision === targetDivision) {
                $(this).show();
                
                let gold = parseInt($(this).data('gold')) || 0;
                let silver = parseInt($(this).data('silver')) || 0;
                let bronze = parseInt($(this).data('bronze')) || 0;

                if (gold === prevGold && silver === prevSilver && bronze === prevBronze) {
                    // Tie scenario encountered - retain same displayRank
                } else {
                    displayRank = runningCount;
                }

                const rankCell = $(this).find('.rank-cell').empty();
                if (displayRank <= 3) {
                    const badge = $('<span>').addClass('rank-badge rank-' + displayRank).attr('aria-label', 'Rank ' + displayRank);
                    badge.html('<svg viewBox="0 0 64 56" aria-hidden="true"><circle cx="32" cy="27" r="21" fill="currentColor" stroke="#fff2bf" stroke-width="1.5"/><circle cx="32" cy="27" r="18" fill="none" stroke="#fff" opacity=".4"/><g fill="currentColor" stroke="#fff2bf" stroke-width=".6"><path d="M29 53C8 49 0 29 10 9M35 53C56 49 64 29 54 9" fill="none" stroke="currentColor" stroke-width="2"/>' + [0,1,2,3,4,5].map(i => '<ellipse cx="7" cy="' + (15+i*6) + '" rx="3" ry="6" transform="rotate(-35 7 ' + (15+i*6) + ')"/><ellipse cx="57" cy="' + (15+i*6) + '" rx="3" ry="6" transform="rotate(35 57 ' + (15+i*6) + ')"/>').join('') + '</g></svg>');
                    badge.append($('<span>').text(displayRank));
                    rankCell.append(badge);
                } else { rankCell.text(displayRank); }
                $(this).attr('data-rank', displayRank);

                let nameElement = $(this).find('.school-name-text');
                let defaultColor = nameElement.data('default-color');
                
                if (displayRank === 1) {
                    nameElement.css('color', '#D4AF37'); 
                } else if (displayRank === 2) {
                    nameElement.css('color', '#64748B'); 
                } else if (displayRank === 3) {
                    nameElement.css('color', '#C2410C'); 
                } else {
                    nameElement.css('color', defaultColor); 
                }

                prevGold = gold;
                prevSilver = silver;
                prevBronze = bronze;
                
                runningCount++;
                visibleCount++;
            } else {
                $(this).hide();
            }
        });

        // Apply background alternating colors ONLY to visible rows 
        // to maintain the true odd/even pattern no matter the active filter tab
        $('.ranking-row:visible').each(function(index) {
            if (index % 2 === 0) {
                // Index is 0, 2, 4 (Odd Ranks: 1st, 3rd, 5th, etc.) -> Fixed White
                $(this).css('background', '#ffffff');
            } else {
                // Index is 1, 3, 5 (Even Ranks: 2nd, 4th, 6th, etc.) -> Slightly Pink
                $(this).css('background', 'rgba(57, 116, 71, 0.08)');
            }
        });

        if (visibleCount === 0) {
            $('#noRankingsRow').show();
            $('#rankingsTable').hide();
        } else {
            $('#noRankingsRow').hide();
            $('#rankingsTable').show();
        }
        requestAnimationFrame(fitTallyArtwork);
    }

    function fitTallyArtwork() {
        const board = document.querySelector('.tally-board');
        const art = board?.querySelector('.meet-art');
        if (!art) return;
        const viewport = window.visualViewport?.height || window.innerHeight;
        // Measure natural content before assigning extra portrait space.
        board.style.removeProperty('--tally-available-height');
        board.style.setProperty('--tally-art-height', '0px');
        const nav = document.querySelector('.mobile-bottom-nav');
        const navRect = nav?.getBoundingClientRect();
        const bottom = navRect && getComputedStyle(nav).display !== 'none' && navRect.width > navRect.height ? Math.min(viewport, navRect.top) - 12 : viewport - 16;
        const naturalTop = board.getBoundingClientRect().top + window.scrollY;
        const fixedContent = board.offsetHeight - art.getBoundingClientRect().height;
        const portrait = window.matchMedia('(max-width: 991.98px) and (orientation: portrait)').matches;
        const landscape = window.matchMedia('(max-width: 991.98px) and (orientation: landscape)').matches;
        const maxArt = landscape ? 35 : (portrait ? 90 : 130);
        const available = Math.max(0, bottom - naturalTop);
        board.style.setProperty('--tally-art-height', Math.max(0, Math.min(maxArt, available - fixedContent)) + 'px');
        if (portrait) board.style.setProperty('--tally-available-height', available + 'px');
    }
    window.addEventListener('resize', fitTallyArtwork);
    window.addEventListener('load', fitTallyArtwork);
    window.visualViewport?.addEventListener('resize', fitTallyArtwork);
</script>
}
