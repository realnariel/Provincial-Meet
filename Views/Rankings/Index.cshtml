        animation: gradientMove 12s ease-in-out infinite;
        border-radius: var(--cc-radius-lg, 14px);
        
        /* 3D Pop-Up Shadows */
        box-shadow: 0 12px 24px rgba(18, 63, 45, 0.4), 
                    0 8px 8px rgba(18, 63, 45, 0.25), 
                    inset 0 2px 4px rgba(255, 255, 255, 0.2), 
                    inset 0 -3px 6px rgba(0, 0, 0, 0.3);
        transform: translateY(-3px);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease, border-color 0.3s ease;
        
        color: #ffffff;
        border-left: 5px solid var(--cc-gold-light, #F5E3A1);
        border: 1px solid rgba(255,255,255,0.12);
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex: 1;
        min-width: 140px;
        max-width: 260px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .stat-card-clean:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 35px rgba(57, 116, 71, 0.5), 
                    0 10px 12px rgba(57, 116, 71, 0.3), 
                    inset 0 2px 5px rgba(255, 255, 255, 0.3), 
                    inset 0 -3px 6px rgba(0, 0, 0, 0.4) !important; 
        border-color: rgba(255,255,255,0.35);
    }

    .stat-title {
        font-family: var(--font-body, 'Inter', sans-serif);
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-align: center;
        font-weight: 700;
    }

    .stat-value {
        font-family: var(--font-body, 'Inter', sans-serif);
        color: #ffffff;
        font-size: 1.1rem; 
        font-weight: 800;
        margin-top: 4px;
        line-height: 1.2;
        text-align: center;
    }

    /* Division Filter Tabs - 3D Pop Style */
    .division-filters {
        display: flex;
        gap: 12px;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        background: linear-gradient(135deg, rgba(241, 245, 249, 0.9) 0%, rgba(226, 232, 240, 0.9) 100%);
        border: 1px solid rgba(18, 63, 45, 0.15); 
        color: var(--cc-primary, #123F2D);
        font-family: var(--font-body, 'Inter', sans-serif);
        font-weight: 700;
        text-transform: uppercase;
        padding: 8px 22px;
