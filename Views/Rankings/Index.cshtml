                    0 5px 8px rgba(57, 116, 71, 0.25), 
                    inset 0 2px 4px rgba(255, 255, 255, 0.3), 
                    inset 0 -3px 4px rgba(0, 0, 0, 0.3);
    }

    /* Minimalist Rankings Table Layout */
