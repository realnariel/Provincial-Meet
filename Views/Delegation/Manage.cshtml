@model IEnumerable<ProvMeet.Models.EventQualifier>
@{
    var eventDetails = ViewBag.Event as ProvMeet.Models.Event;
    var teams = ViewBag.Teams as List<ProvMeet.Models.Team> ?? new List<ProvMeet.Models.Team>();
    ViewData["Title"] = "Manage Delegation - " + eventDetails?.Title;

    var tShirtSizes = new[] { "12", "14", "16", "18", "20", "XXS", "XS", "S", "M", "L", "XL", "2XL", "3XL" };
    // Sort participants: Gold winners first, then Silver, then Bronze, followed by others
    var sortedModel = Model?.OrderBy(q => {
        if (!string.IsNullOrEmpty(eventDetails?.GoldWinnerName) && eventDetails.GoldWinnerName.Contains(q.ParticipantName)) return 1;
        if (!string.IsNullOrEmpty(eventDetails?.SilverWinnerName) && eventDetails.SilverWinnerName.Contains(q.ParticipantName)) return 2;
        if (!string.IsNullOrEmpty(eventDetails?.BronzeWinnerName) && eventDetails.BronzeWinnerName.Contains(q.ParticipantName)) return 3;
        return 4;
    }).ThenBy(q => q.ParticipantName).ToList() ?? new List<ProvMeet.Models.EventQualifier>();
}

<style>
    /* ========================================== */
    /* MASTER OPACITY & COLOR CONTROL             */
    :root {
        --card-opacity: 1.0; 
    }
    /* ========================================== */

    body {
        background-color: var(--cc-background) !important; 
    }

    /* Animated Gradient Core Setup */
    @@keyframes gradientMove {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .glass-card { 
        background: white; 
        border-radius: var(--cc-radius-lg, 14px); 
        box-shadow: 0 10px 30px rgba(18, 63, 45, 0.08); 
        border: 1px solid rgba(18, 63, 45, 0.15);
        border-top: 5px solid var(--cc-gold, #C8A354); 
    }
    
    .form-control-custom { 
        border: 1px solid var(--cc-border, #D9DEE5); 
        border-radius: 6px; 
        font-family: var(--font-body, 'Inter', sans-serif);
        padding: 0.75rem 1rem;
    }
    
    .form-control-custom:focus { 
        border-color: var(--cc-primary, #123F2D); 
        box-shadow: 0 0 0 0.2rem rgba(18, 63, 45, 0.15); 
    }

    .table-edit-custom th {
        font-family: var(--font-body, 'Inter', sans-serif);
        background: linear-gradient(-45deg, 
            rgba(18, 63, 45, var(--card-opacity)) 0%, 
            rgba(9, 45, 32, var(--card-opacity)) 65%, 
            rgba(57, 116, 71, var(--card-opacity)) 90%, 
            rgba(18, 63, 45, var(--card-opacity)) 100%);
        background-size: 300% 300%;
        animation: gradientMove 12s ease-in-out infinite;
        color: #ffffff;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        padding: 14px 16px;
        letter-spacing: 0.5px;
        border: none;
        vertical-align: middle;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .table-edit-custom td {
        padding: 12px 16px;
        vertical-align: middle;
        font-family: var(--font-body, 'Inter', sans-serif);
        border-bottom: 1px solid #dee2e6;
    }

    /* Strict Desktop View Alternating Rows with Theme Tint */
    @@media (min-width: 769px) {
        .edit-table tbody tr {
            background-color: #ffffff;
        }
        .edit-table tbody tr:nth-child(even) {
            background-color: rgba(57, 116, 71, 0.03);
        }
        .edit-table tbody tr:hover {
            background-color: rgba(18, 63, 45, 0.06) !important;
        }
    }

    .btn-custom-primary {
        background: linear-gradient(135deg, var(--cc-primary, #123F2D) 0%, var(--cc-secondary, #397447) 100%);
        border: none;
        color: white;
        font-weight: 700;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(18, 63, 45, 0.2);
    }

    .btn-custom-primary:hover {
        opacity: 0.95;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(57, 116, 71, 0.3);
        color: white;
    }

    /* Progress Overlay Styling */
    #progressOverlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.85);
        z-index: 9999;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(4px);
    }

    /* Mobile Responsive Card Transformation */
    @@media (max-width: 768px) {
        .edit-table thead { display: none; }
        
        .edit-table tbody tr {
            display: flex;
            flex-direction: column;
            background: linear-gradient(-45deg, 
                rgba(18, 63, 45, var(--card-opacity)) 0%, 
                rgba(9, 45, 32, var(--card-opacity)) 65%, 
                rgba(57, 116, 71, var(--card-opacity)) 90%, 
                rgba(18, 63, 45, var(--card-opacity)) 100%) !important;
            background-size: 300% 300%;
            animation: gradientMove 12s ease-in-out infinite;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-left: 5px solid var(--cc-gold, #C8A354) !important;
            border-radius: var(--cc-radius-lg, 14px);
            margin-bottom: 1.25rem;
            padding: 1.25rem;
            box-shadow: 0 8px 24px rgba(18, 63, 45, 0.2);
            gap: 0.75rem;
            color: #ffffff;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        
        .edit-table tbody td {
            display: flex;
            flex-direction: column;
            width: 100%;
            border: none !important;
            padding: 0 !important;
            text-align: left !important;
        }
        
        .edit-table tbody td::before {
            content: attr(data-label);
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 3px;
        }

        .edit-table tbody td.mobile-select-row {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.1);
            padding: 8px 12px !important;
            border-radius: 8px;
        }
        
        .edit-table tbody td.mobile-select-row::before {
            content: "Select Row";
            margin-bottom: 0;
        }
    }
    .participant-field-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    @@media (max-width: 768px) {
        .edit-table, .edit-table tbody { display: block; width: 100%; }
        .edit-table tbody tr { padding: 14px; gap: 12px; animation: none; }
        .edit-table tbody td {
            background: transparent !important; box-shadow: none !important;
            color: #fff; min-width: 0; width: 100% !important;
        }
        .edit-table tbody td::before { display: none; }
        .edit-table .participant-field-label {
            position: static; width: auto; height: auto; overflow: visible; clip-path: none;
            display: block; color: #f5e3a1; font-size: .8rem; font-weight: 700; margin-bottom: 5px;
        }
        .edit-table tbody td.mobile-select-row { background: rgba(255,255,255,.1) !important; }
        .edit-table tbody td.mobile-select-row::before { display: block; content: "Select participant"; color: #fff; }
        .edit-table .form-control, .edit-table .form-select {
            border-radius: 8px; min-height: 42px; font-size: 16px;
            background-color: #fff; color: #123f2d; border: 1px solid #d9dee5;
        }
        .edit-table td[colspan] { color: #fff !important; }
    }
</style>

<!-- Fullscreen Progress Overlay -->
<div id="progressOverlay">
    <h4 id="progressText" class="mb-4 fw-bold" style="color: var(--cc-primary, #123F2D); font-family: var(--font-body);">Processing...</h4>
    <div class="progress w-75 rounded-pill shadow-sm" style="max-width: 400px; height: 1.5rem;">
        <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="mb-4">
        <a asp-controller="Events" asp-action="SubmitResults" asp-route-id="@eventDetails?.Id" class="text-decoration-none text-muted fw-bold" style="font-size: 0.85rem; font-family: var(--font-body);">
            <i class="bi bi-arrow-left"></i> Back to Official Results
        </a>
    </div>

    <div class="glass-card p-4 p-md-5">
        <div class="mb-4">
            <h2 style="font-family: var(--font-body); color: var(--cc-primary, #123F2D); font-weight: 800;">
                <i class="bi bi-people-fill text-warning me-2"></i> DELEGATION: @eventDetails?.Title
            </h2>
            <p class="text-muted fw-bold" style="font-family: var(--font-body);">Manage athletes, coaches, and chaperons for this event.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Add Participant Form -->
        <div class="card mb-4 border-0 bg-light p-3 rounded-3 shadow-sm">
            <div class="card-body">
                <h5 class="mb-3 fw-bold" style="font-family: var(--font-body); color: var(--cc-primary, #123F2D);">
                    <i class="bi bi-person-plus-fill me-1 text-warning"></i> Add New Participant
                </h5>
                <p class="small text-muted">Enter a participant manually, or choose recorded winners below.</p>
                <form asp-action="SaveQualifier" method="post" id="participantForm">
                    <input type="hidden" name="EventId" value="@eventDetails?.Id" />
                    <input type="hidden" name="Id" value="@Guid.Empty" />
                    
                    <div class="row g-2">
                        <div class="col-md-6 col-lg-4">
                            <input type="text" name="ParticipantName" class="form-control form-control-custom" placeholder="Full Name" required />
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <select name="Role" class="form-select form-control-custom">
                                <option value="Athlete" selected>Athlete</option>
                                <option value="Coach">Coach</option>
                                <option value="Assistant Coach">Assistant Coach</option>
                                <option value="Chaperon">Chaperone</option>
                            </select>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <select name="Team" class="form-select form-control-custom" required>
                                <option value="">Select Team</option>
                                @foreach (var team in teams) {
                                    <option value="@team.Name">@team.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <input type="text" name="SpecificDistrict" class="form-control form-control-custom" placeholder="School / district (optional)" aria-label="School or district" />
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <select name="TshirtSize" class="form-select form-control-custom">
                                <option value="">T-Shirt Size</option>
                                @foreach (var size in tShirtSizes) {
                                    <option value="@size">@size</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <button type="submit" class="btn btn-custom-primary w-100 fw-bold py-2">
                                <i class="bi bi-plus-lg"></i> Add
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <details class="card mb-4 p-3">
            <summary class="fw-bold">Choose recorded Silver and Bronze winners</summary>
            <p class="small text-muted mt-2">Winners from @eventDetails?.SportName in the @eventDetails?.Division division. Existing athletes in this delegation will be skipped.</p>
            @{
                var winnerCandidates = ViewBag.WinnerCandidates as List<ProvMeet.Models.WinnerCandidate> ?? new();
            }
            @if (!winnerCandidates.Any()) {
                <p class="mb-0">No recorded Silver or Bronze winners are available for this sport and division.</p>
            } else {
                <form asp-action="AddRecordedWinners" method="post">
                    <input type="hidden" name="eventId" value="@eventDetails?.Id" />
                    <label class="d-block mb-2"><input type="checkbox" onchange="this.form.querySelectorAll('[name=selectedWinners]').forEach(box => box.checked = this.checked)" /> Select all winners</label>
                    <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>Select</th><th>Player</th><th>Team</th><th>Category</th><th>Medal</th><th>Event</th></tr></thead>
                            <tbody>@foreach (var candidate in winnerCandidates) {
                                <tr><td><input type="checkbox" name="selectedWinners" value="@candidate.Key" aria-label="Select @candidate.Result.Player" /></td><td>@candidate.Result.Player</td><td>@candidate.Result.Team</td><td>@candidate.Result.Category</td><td>@candidate.Result.Medal</td><td>@candidate.Result.EventTitle</td></tr>
                            }</tbody>
                        </table>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">Add selected winners as athletes</button>
                </form>
            }
        </details>

        <!-- Inline Editable Grid Form for Existing Participants -->
        <form method="post" id="bulkActionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="eventId" value="@eventDetails?.Id" />

            <!-- Action Toolbar -->
            <div class="d-flex justify-content-between align-items-center mb-3 bg-light p-3 rounded border flex-wrap gap-2">
                <span class="fw-bold text-dark" style="font-size: 0.85rem; font-family: var(--font-body);">
                    <i class="bi bi-info-circle text-primary"></i> Edit participants directly in the table below, then click <strong>Save All Changes</strong>.
                </span>
                <div class="d-flex gap-2">
                    <button type="button" id="btnDeleteSelected" formnovalidate formaction="@Url.Action("BulkDelete", new { eventId = eventDetails?.Id })" class="btn btn-outline-danger fw-bold btn-sm px-3">
                        <i class="bi bi-trash"></i> Delete Selected
                    </button>
                    <button type="button" id="btnSaveAll" formaction="@Url.Action("BulkSave", new { eventId = eventDetails?.Id })" class="btn btn-custom-primary fw-bold btn-sm px-4">
                        <i class="bi bi-save"></i> Save All Changes
                    </button>
                </div>
            </div>

            <!-- List of Qualifiers (Inline Editable) -->
            <div class="table-responsive">
                <table class="table table-edit-custom edit-table w-100 mb-0 align-middle">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 35px; min-width: 35px;">
                                <input type="checkbox" id="selectAll" class="form-check-input" onclick="toggleSelectAll(this)" />
                            </th>
                            <th style="width: 25%;">Participant Name</th>
                            <th style="width: 20%;">Team</th>
                            <th style="width: 20%;">School / District</th>
                            <th style="width: 20%;">Role</th>
                            <th style="width: 12%;">T-Shirt Size</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!sortedModel.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted fw-bold">No participants added yet.</td>
                            </tr>
                        }
                        else
                        {
                            int index = 0;
                            foreach (var item in sortedModel)
                            {
                                <tr>
                                    <td class="text-center mobile-select-row" style="width: 35px;">
                                        <input type="checkbox" name="selectedIds" value="@item.Id" class="form-check-input row-checkbox" aria-label="Select @item.ParticipantName" />
                                        <input type="hidden" name="qualifiers[@index].Id" value="@item.Id" />
                                        <input type="hidden" name="qualifiers[@index].EventId" value="@item.EventId" />
                                    </td>
                                    <td data-label="Participant Name"><label class="participant-field-label" for="participant-@index-ParticipantName">Participant Name</label>
                                        <input type="text" id="participant-@index-ParticipantName" name="qualifiers[@index].ParticipantName" value="@item.ParticipantName" class="form-control form-control-sm fw-bold" required placeholder="Full Name" />
                                    </td>
                                    <td data-label="Team"><label class="participant-field-label" for="participant-@index-Team">Team</label>
                                        <select id="participant-@index-Team" name="qualifiers[@index].Team" class="form-select form-select-sm" required>
                                            <option value="">Select Team</option>
                                            @foreach (var team in teams)
                                            {
                                                if (item.Team == team.Name) { <option value="@team.Name" selected>@team.Name</option> }
                                                else { <option value="@team.Name">@team.Name</option> }
                                            }
                                        </select>
                                    </td>
                                    <td data-label="School / District"><label class="participant-field-label" for="participant-@index-SpecificDistrict">School / District</label>
                                        <input type="text" id="participant-@index-SpecificDistrict" name="qualifiers[@index].SpecificDistrict" value="@item.SpecificDistrict" class="form-control form-control-sm" aria-label="School or district for @item.ParticipantName" />
                                    </td>
                                    <td data-label="Role"><label class="participant-field-label" for="participant-@index-Role">Role</label>
                                        <select id="participant-@index-Role" name="qualifiers[@index].Role" class="form-select form-select-sm">
                                            @if (item.Role?.ToLower() == "coach") { <option value="Coach" selected>Coach</option> } else { <option value="Coach">Coach</option> }
                                            @if (item.Role?.ToLower() == "assistant coach") { <option value="Assistant Coach" selected>Assistant Coach</option> } else { <option value="Assistant Coach">Assistant Coach</option> }
                                            @if (item.Role?.ToLower() == "chaperon" || item.Role?.ToLower() == "chaperone") { <option value="Chaperon" selected>Chaperone</option> } else { <option value="Chaperon">Chaperone</option> }
                                            @if (item.Role?.ToLower() != "coach" && item.Role?.ToLower() != "assistant coach" && item.Role?.ToLower() != "chaperon" && item.Role?.ToLower() != "chaperone") { <option value="Athlete" selected>Athlete</option> } else { <option value="Athlete">Athlete</option> }
                                        </select>
                                    </td>
                                    <td data-label="T-Shirt Size"><label class="participant-field-label" for="participant-@index-TshirtSize">T-Shirt Size</label>
                                        <select id="participant-@index-TshirtSize" name="qualifiers[@index].TshirtSize" class="form-select form-select-sm">
                                            <option value="">Size</option>
                                            @foreach (var size in tShirtSizes)
                                            {
                                                if (item.TshirtSize == size) { <option value="@size" selected>@size</option> }
                                                else { <option value="@size">@size</option> }
                                            }
                                        </select>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleSelectAll(source) {
        let checkboxes = document.querySelectorAll('.row-checkbox');
        for (let i = 0, n = checkboxes.length; i < n; i++) {
            checkboxes[i].checked = source.checked;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const participantForm = document.getElementById('participantForm');
        const bulkForm = document.getElementById('bulkActionForm');
        const btnDelete = document.getElementById('btnDeleteSelected');
        const btnSave = document.getElementById('btnSaveAll');
        
        const overlay = document.getElementById('progressOverlay');
        const progressText = document.getElementById('progressText');
        const progressBar = document.getElementById('progressBar');

        function showProgress(text, colorClass) {
            progressText.innerText = text;
            progressBar.className = 'progress-bar progress-bar-striped progress-bar-animated ' + colorClass;
            overlay.style.display = 'flex';
        }

        // Handle Add Participant Form
        if (participantForm) {
            participantForm.addEventListener('submit', function() {
                showProgress('Adding participant...', 'bg-success');
            });
        }

        // Handle Delete Selected Button
        if (btnDelete) {
            btnDelete.addEventListener('click', function(e) {
                e.preventDefault();
                let checkboxes = document.querySelectorAll('.row-checkbox:checked');
                
                if (checkboxes.length === 0) {
                    alert('Please select at least one participant to delete.');
                    return;
                }
                
                if (confirm('Are you sure you want to delete all selected participants?')) {
                    showProgress('Deleting selected participants...', 'bg-danger');
                    bulkForm.noValidate = true;
                    bulkForm.action = btnDelete.getAttribute('formaction');
                    bulkForm.submit();
                }
            });
        }

        // Handle Save All Changes Button
        if (btnSave) {
            btnSave.addEventListener('click', function(e) {
                e.preventDefault();
                bulkForm.noValidate = false;
                
                if (bulkForm.checkValidity()) {
                    showProgress('Saving all changes...', 'bg-primary');
                    bulkForm.action = btnSave.getAttribute('formaction');
                    bulkForm.submit();
                } else {
                    bulkForm.reportValidity();
                }
            });
        }
    });
</script>
