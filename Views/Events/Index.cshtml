    .event-search-field #searchInput { padding-left: 36px; }
    #eventFiltersToggle, .event-sheet-label { display: none; }
    #eventFiltersSheet { height: auto; max-height: 88vh; max-height: 88dvh; border-radius: 20px 20px 0 0; background: #f6f9f3; color: #123f2d; z-index: 1060; }
    #eventFiltersSheet .offcanvas-header { padding: 16px 20px; border-bottom: 1px solid #dce5de; }
    #eventFiltersSheet .offcanvas-title { color: #123f2d; font-size: 20px; }
    #eventFiltersSheet .offcanvas-body { padding: 8px 20px 20px; overflow-y: auto; }
    #eventFiltersSheet .event-sheet-label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px; }
    #eventFiltersSheet .form-select { min-height: 44px; font-size: 16px; background: white !important; color: #123f2d; border: 1px solid #c4d5c9 !important; box-shadow: none !important; }
    .event-sheet-footer { display: flex; gap: 12px; padding: 12px 20px calc(16px + env(safe-area-inset-bottom)); border-top: 1px solid #dce5de; }
    .event-sheet-footer .btn { flex: 1; min-height: 44px; }
    .event-sheet-footer .btn-success { background: #123f2d; border-color: #123f2d; }
    @@media (max-width: 768px) {
        #eventFilterSlot { display: none; }
        .event-stats { --bs-gutter-x: 8px; --bs-gutter-y: 8px; margin-bottom: 14px !important; }
        .event-stats .stat-total, .event-stats .stat-pending { display: none; }
        .event-stats .stat-finished, .event-stats .stat-last { width: 50%; }
        .event-stats .stat-card-clean { padding: 10px 12px; min-height: 0; border-radius: 12px; }
        .event-stats .stat-title { font-size: 10px; line-height: 1.2; margin-bottom: 4px; letter-spacing: .3px; }
        .event-stats .stat-value { font-size: 21px; line-height: 1.15; margin-top: 0 !important; }
        .event-stats .stat-value-prominent { font-size: 1.25rem; line-height: 1.2; }
        .event-stats .stat-last-update { font-size: 1.15rem !important; line-height: 1.25 !important; }
        .event-stats .stat-subtext { font-size: .75rem; }
        .event-stats .progress-bar-glass { height: 16px; margin-top: 7px; }
        .event-division-tabs { gap: 6px; margin-bottom: 8px; }
        .event-division-tabs .filter-btn { min-width: 0; font-size: clamp(10px, 2.8vw, 12px); padding: 9px 6px; }
        .event-filter-bar { margin-left: 0 !important; margin-right: 0 !important; }
        .event-filter-bar .event-search-row { display: flex; align-items: stretch; gap: 8px; width: 100%; padding: 0; }
        .event-search-field #searchInput { min-height: 46px; font-size: 16px; box-shadow: none !important; }
        #eventFiltersToggle { display: block; flex: 0 0 auto; min-height: 46px; padding: 8px 12px; border-radius: 12px; background: #123f2d; color: #fff3c4; font-size: 14px; white-space: nowrap; }
        #eventFilterFields > div { width: 100%; }
    }

    .event-stats .stat-header { display: flex; align-items: center; justify-content: space-between; color: rgba(255,255,255,.8); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
    .event-stats .stat-header i { color: #f5e3a1; font-size: 1.25rem; }
    .event-stats .stat-value-prominent { color: #fff; font-size: 1.6rem; font-weight: 800; line-height: 1.2; }
    .event-stats .stat-subtext { color: rgba(255,255,255,.72); font-weight: 600; font-size: .85rem; }
    .event-stats .progress-bar-glass { position: relative; height: 18px; margin-top: 8px; border-radius: 999px; background: rgba(0,0,0,.32); border: 1px solid rgba(255,255,255,.18); overflow: hidden; }
    .event-stats .progress-fill { height: 100%; background: #f5e3a1; border-radius: inherit; }
    .event-stats .progress-text { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; font-size: .72rem; font-weight: 800; }
    .event-stats .mobile-stat-content { display: none; }
    .event-stats .live-indicator { display: inline-block; width: 7px; height: 7px; margin-right: 5px; border-radius: 50%; background: #ef4444; box-shadow: 0 0 0 2px #ef444433; animation: livePulse 1.2s ease-in-out infinite; vertical-align: middle; }
    .event-action-buttons { display: flex; flex-wrap: nowrap !important; align-items: center; gap: 8px; overflow-x: auto; overflow-y: hidden; width: auto; scrollbar-width: none; }
    .event-action-buttons::-webkit-scrollbar { display: none; }
    .event-action-buttons > .btn, .event-action-buttons > a { flex: 0 0 auto; white-space: nowrap; }
    @@keyframes livePulse { 0%, 100% { opacity: .45; transform: scale(.85); } 50% { opacity: 1; transform: scale(1.15); } }
    @@media (max-width: 768px) {
        .event-stats .desktop-stat-content { display: none; }
        .event-stats .mobile-stat-content { display: block; }
        .event-stats .last-update-mobile-value { font-size: .78rem; line-height: 1.1; white-space: nowrap; letter-spacing: -.02em; }
        .event-action-buttons { width: 100%; }
    }
    @@media (max-width: 768px) and (orientation: landscape) {
        #eventFiltersSheet #eventFilterFields > div { width: 50%; }
    }
</style>

<div class="container py-4 py-md-5">
    
    <!-- Header Section -->
    <div class="page-header d-flex justify-content-between align-items-end">
        <div>
            <h1 class="display-6 fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-calendar-event-fill text-warning"></i> EVENT RECORDS
            </h1>
            <p class="fs-6 text-muted mb-0" style="font-family: var(--font-body); font-weight: 600;">Bohol Provincial Athletic Meet 2026 Event Records</p>
        </div>
    </div>

    <!-- Dashboard Metric Summary Cards (3D Animated Navy-Burgundy FX) -->
    <div class="row row-cols-2 row-cols-md-4 g-3 mb-4 event-stats">
        <div class="col stat-total">
            <div class="stat-card-clean">
                <div class="stat-title d-flex justify-content-between">Total Events<i class="bi bi-calendar-event text-white-50 d-none d-md-block"></i></div>
                <div class="stat-value">@totalEvents</div>
            </div>
        </div>
        <div class="col stat-finished">
            <div class="stat-card-clean" style="border-left-color: var(--cc-gold, #C8A354);">
                <div class="desktop-stat-content">
                    <div class="stat-title d-flex justify-content-between">Completed<i class="bi bi-check-circle text-white-50 d-none d-md-block"></i></div>
                    <div class="stat-value" style="color: var(--cc-gold-light, #F5E3A1) !important;">@completedCount</div>
                </div>
                <div class="mobile-stat-content">
                    <div class="stat-header"><span>Finished</span><i class="bi bi-check-circle-fill"></i></div>
                    <div class="stat-value-prominent text-center mt-1 mb-2">@completedCount / @totalEvents</div>
                    <div class="progress-bar-glass"><div class="progress-fill" style="width: @progressPercent.ToString("F2")%"></div><div class="progress-text">@progressPercent.ToString("F0")%</div></div>
                </div>
            </div>
        </div>
        <div class="col stat-pending">
            <div class="stat-card-clean">
                <div class="stat-title d-flex justify-content-between">Pending<i class="bi bi-clock text-white-50 d-none d-md-block"></i></div>
                <div class="stat-value" style="color: var(--cc-gold-light, #F5E3A1) !important;">@pendingCount</div>
            </div>
        </div>
        <div class="col stat-last">
            <div class="stat-card-clean" style="border-left-color: var(--cc-gold, #C8A354);">
                <div class="desktop-stat-content">
                    <div class="stat-title d-flex justify-content-between">Last Update<i class="bi bi-arrow-clockwise text-white-50 d-none d-md-block"></i></div>
                    <div class="stat-value stat-last-update" style="font-size: 0.95rem; margin-top: 10px; line-height: 1.2;">@lastUpdateText</div>
                </div>
                <div class="mobile-stat-content">
                    <div class="stat-header"><span>Last Update</span><i class="bi bi-clock-history"></i></div>
                    <div class="stat-value-prominent last-update-mobile-value mt-1">@lastUpdateMobileText</div>
                    <div class="stat-subtext"><span class="live-indicator" aria-hidden="true"></span>Live Data</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-stretch">
        
        <div class="col-12 d-flex flex-column">
            
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h4 class="mb-0 fw-bold" style="font-family: var(--font-body); color: var(--cc-primary);">Events</h4>
                
                <div class="event-action-buttons">
                    @if (User?.Identity?.IsAuthenticated == true) {
                        <button id="btnViewAssigned" class="btn btn-outline-primary fw-bold btn-3d-pop" style="padding: 6px 16px; font-size: 0.85rem; border-radius: 4px; border: 2px solid var(--cc-primary); color: var(--cc-primary); background-color: transparent;" onclick="toggleAssignedEvents()">
                            <i class="bi bi-person-lines-fill"></i> View Assigned Events
                        </button>
                    }
                    @if (User?.IsInRole("Admin") == true) { 
                        <a asp-controller="Home" asp-action="PendingEventsReport" class="btn btn-outline-warning text-dark fw-bold btn-3d-pop" style="padding: 6px 16px; font-size: 0.85rem; border: 2px solid #ffc107;">
                            <i class="bi bi-clock-history"></i> Pending Report
                        </a>
                        <a asp-action="Create" class="btn btn-primary fw-bold btn-3d-pop" style="padding: 6px 16px; font-size: 0.85rem; background-color: var(--cc-primary, #123F2D); border: none;">
                            <span><i class="bi bi-plus-lg"></i> Add Event</span>
                        </a> 
                    }
                </div>
            </div>

            <!-- Division Filters with 3D Pop -->
            <div class="division-filters event-division-tabs">
                <button class="filter-btn active-filter" onclick="setDivisionFilter('All', this)">Overall</button>
                <button class="filter-btn" onclick="setDivisionFilter('Elementary', this)">Elementary</button>
                <button class="filter-btn" onclick="setDivisionFilter('Secondary', this)">Secondary</button>
                <button class="filter-btn" onclick="setDivisionFilter('Paragames', this)">Paragames</button>
            </div>
            
            <!-- Filters -->
            <div class="filter-bar row g-3 event-filter-bar">
                <div class="col-md-3 event-search-row">
                    <div class="event-search-field">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search" id="searchInput" class="form-control form-control-custom" aria-label="Search event title" placeholder="Search event title..." oninput="applyFilters()">
                    </div>
                    <button type="button" id="eventFiltersToggle" class="btn" data-bs-toggle="offcanvas" data-bs-target="#eventFiltersSheet" aria-controls="eventFiltersSheet" aria-expanded="false"><i class="bi bi-sliders" aria-hidden="true"></i> Filters<span id="eventFilterCount"></span></button>
                </div>
                <div class="col-md-9" id="eventFilterSlot">
                <div id="eventFilterFields" class="row g-3">
                <div class="col-md-4">
                    <label class="event-sheet-label" for="sportFilter">Sport</label>
                    <select id="sportFilter" class="form-select form-control-custom" aria-label="Sport" onchange="applyFilters()">
                        <option value="">All Sports</option>
                        @foreach(var sport in eventsList.Select(e => e?.SportName?.Trim()).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s)){ 
                            <option value="@sport">@sport</option> 
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="event-sheet-label" for="categoryFilter">Category</label>
                    <select id="categoryFilter" class="form-select form-control-custom" aria-label="Category" onchange="applyFilters()">
                        <option value="">All Categories</option>
                        <option value="Boys">Boys</option>
                        <option value="Girls">Girls</option>
                        <option value="Mixed">Mixed</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="event-sheet-label" for="statusFilter">Status</label>
                    <select id="statusFilter" class="form-select form-control-custom" aria-label="Status" onchange="applyFilters()">
                        <option value="">All Statuses</option>
                        <option value="Completed">Completed</option>
                        <option value="Pending">Pending</option>
                    </select>
                </div>
                </div>
                </div>
            </div>
            <div class="offcanvas offcanvas-bottom" id="eventFiltersSheet" tabindex="-1" aria-labelledby="eventFiltersTitle">
                <div class="offcanvas-header">
                    <h5 id="eventFiltersTitle" class="offcanvas-title">Filter events</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close filters"></button>
                </div>
                <div class="offcanvas-body"></div>
                <div class="event-sheet-footer">
                    <button type="button" class="btn btn-outline-secondary" id="clearEventFilters">Clear filters</button>
                    <button type="button" class="btn btn-success" data-bs-dismiss="offcanvas">Show events</button>
                </div>
            </div>

            <!-- Main Table / Mobile Cards -->
            <div class="flex-grow-1 table-container-card">
                @if(!eventsList.Any()){ 
                    <div class="text-center py-5 rounded shadow-sm" style="background: rgba(255,255,255,0.4); backdrop-filter: blur(10px);">
                        <i class="bi bi-calendar-x" style="font-size: 3rem; color: var(--cc-text-muted);"></i>
                        <p class="mt-3 text-muted fw-bold">No athletic events scheduled yet.</p>
                    </div> 
                }
                else {
                    <div class="table-responsive">
                        <table class="minimalist-table mobile-cards w-100" id="eventsTable">
                            <thead>
                                <tr>
                                    <th style="width: 25%;">Sport & Class</th>
                                    <th style="width: 32%;">Event Title</th>
                                    <th style="width: 28%;">Winners Allocation</th>
                                    <th class="text-center" style="width: 15%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ev in eventsList) {
                                    if (ev == null) continue;
                                    bool hasResults = ev.GoldTeamId.HasValue || ev.SilverTeamId.HasValue || ev.BronzeTeamId.HasValue;
                                    
                                    var coordIdStr = ev.CoordinatorId?.ToString() ?? "";
                                    bool isCoordinator = !string.IsNullOrEmpty(coordIdStr) && coordIdStr == currentCoordinatorIdStr;
                                    
                                    bool isAuthorized = User?.Identity?.IsAuthenticated == true &&
                                        (User?.IsInRole("Admin") == true || isCoordinator);
                                    
                                    <tr class="event-row" 
                                        data-title="@(ev.Title?.Trim().ToLower() ?? "")"
                                        data-sport="@(ev.SportName?.Trim() ?? "")" 
                                        data-category="@(ev.SportCategory?.Trim() ?? "")"
                                        data-division="@(ev.Division?.Trim() ?? "")" 
                                        data-status="@(ev.Status?.Trim() ?? "")" 
                                        data-is-assigned="@(isCoordinator ? "true" : "false")">
                                        <td>
                                            @if(ev.Status == "Completed") {
                                                <span class="status-indicator status-completed-dot"></span><small class="fw-bold status-completed-text">Completed</small>
                                            } else {
                                                <span class="status-indicator status-pending-dot"></span><small class="fw-bold status-pending-text">Pending</small>
                                            }
                                            <br />
                                            <span class="badge sport-badge mt-1 text-uppercase"><span class="sport-row-icon" aria-hidden="true">@SportIcon(ev.SportName)</span>@ev.SportName</span>
                                            <span class="badge division-badge mt-1 text-uppercase">@ev.Division</span>
                                        </td>
                                        
                                        <td>
                                            <div class="event-title-display">@ev.Title</div>
                                        </td>
                                        
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                @if (ev.GoldTeamId.HasValue && teamAcronymsLookup.ContainsKey(ev.GoldTeamId.Value)) {
                                                    <div style="font-size: 0.9rem;"><span class="medal-text-gold">🥇</span> <span class="fw-bold">@teamAcronymsLookup[ev.GoldTeamId.Value]</span></div>
                                                }
                                                @if (ev.SilverTeamId.HasValue && teamAcronymsLookup.ContainsKey(ev.SilverTeamId.Value)) {
                                                    <div style="font-size: 0.9rem;"><span class="medal-text-silver">🥈</span> <span class="fw-bold">@teamAcronymsLookup[ev.SilverTeamId.Value]</span></div>
                                                }
                                                @if (ev.BronzeTeamId.HasValue && teamAcronymsLookup.ContainsKey(ev.BronzeTeamId.Value)) {
                                                    <div style="font-size: 0.9rem;"><span class="medal-text-bronze">🥉</span> <span class="fw-bold">@teamAcronymsLookup[ev.BronzeTeamId.Value]</span></div>
                                                }
                                                @if (!hasResults) { 
                                                    <small class="text-muted fw-bold"><i class="bi bi-dash"></i>@(ev.Status == "Completed" ? "No results recorded" : "Pending Result")</small>
                                                }
                                            </div>
                                        </td>
                                        
                                        <td class="text-center align-middle">
                                            @if (hasResults || ev.Status == "Completed") {
                                                <a asp-action="SubmitResults" asp-route-id="@ev.Id" class="btn btn-sm w-100 @(isAuthorized ? "btn-outline-primary" : "btn-light border") fw-bold rounded-pill mb-1">@(isAuthorized ? "Update" : "View")</a> 
                                            }
                                            else if (isAuthorized) { 
                                                <a asp-action="SubmitResults" asp-route-id="@ev.Id" class="btn btn-sm w-100 btn-primary fw-bold rounded-pill text-white mb-1" style="background-color: var(--cc-primary, #123F2D); border: none;">Submit Results</a> 
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        
                        <div id="noEventsRow" class="text-center py-5 rounded mt-3" style="display: none; background: rgba(255,255,255,0.4); backdrop-filter: blur(10px);">
                            <p class="mb-0 text-muted fw-bold">No results found matching your filtered criteria.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentDivisionFilter = 'All';
    let viewAssignedOnly = false;

    function saveFilterState() {
        const state = {
            division: currentDivisionFilter,
            search: document.getElementById('searchInput')?.value || '',
            sport: document.getElementById('sportFilter')?.value || '',
            category: document.getElementById('categoryFilter')?.value || '',
            status: document.getElementById('statusFilter')?.value || '',
            assignedOnly: viewAssignedOnly
        };
        try {
            sessionStorage.setItem('prov_events_last_filters', JSON.stringify(state));
        } catch (e) {}
    }

    function loadFilterState() {
        try {
            const saved = sessionStorage.getItem('prov_events_last_filters');
            if (!saved) return;
            const state = JSON.parse(saved);

            if (state.division) {
                currentDivisionFilter = state.division;
                $('.filter-btn').removeClass('active-filter');
                $('.filter-btn').each(function() {
                    const btnText = $(this).text().trim().toLowerCase();
                    const targetDiv = state.division.toLowerCase();
                    if (btnText === targetDiv || (targetDiv === 'all' && btnText === 'overall')) {
                        $(this).addClass('active-filter');
                    }
                });
            }

            if (state.search !== undefined) {
                const searchInput = document.getElementById('searchInput');
                if (searchInput) searchInput.value = state.search;
            }

            if (state.sport !== undefined) {
                const sportFilter = document.getElementById('sportFilter');
                if (sportFilter) sportFilter.value = state.sport;
            }

            if (state.status !== undefined) {
                const statusFilter = document.getElementById('statusFilter');
                if (statusFilter) statusFilter.value = state.status;
            }

            const categoryFilter = document.getElementById('categoryFilter');
            if (categoryFilter) {
                categoryFilter.value = ['Boys', 'Girls', 'Mixed'].includes(state.category) ? state.category : '';
            }

            if (state.assignedOnly === true) {
                viewAssignedOnly = true;
                let btn = document.getElementById('btnViewAssigned');
                if (btn) {
                    btn.style.backgroundColor = 'var(--cc-primary, #123F2D)';
                    btn.style.color = 'white';
                    btn.innerHTML = '<i class="bi bi-collection-fill"></i> View All Events';
                }
            }
        } catch (e) {
            console.error("Error restoring filter state:", e);
        }
    }

    function toggleAssignedEvents() {
        viewAssignedOnly = !viewAssignedOnly;
        
        let btn = document.getElementById('btnViewAssigned');
        if (btn) {
            if (viewAssignedOnly) {
                btn.style.backgroundColor = 'var(--cc-primary, #123F2D)';
                btn.style.color = 'white';
                btn.innerHTML = '<i class="bi bi-collection-fill"></i> View All Events';
            } else {
                btn.style.backgroundColor = 'transparent';
                btn.style.color = 'var(--cc-primary, #123F2D)';
                btn.innerHTML = '<i class="bi bi-person-lines-fill"></i> View Assigned Events';
            }
        }
        
        applyFilters();
    }

    function setDivisionFilter(division, btnElement) {
        $('.filter-btn').removeClass('active-filter');
        $('.event-division-tabs .filter-btn').each(function() {
            const value = $(this).text().trim() === 'Overall' ? 'All' : $(this).text().trim();
            $(this).toggleClass('active-filter', value === division);
        });
        currentDivisionFilter = division;
        applyFilters();
    }

    function applyFilters() {
        var searchInputElem = document.getElementById('searchInput');
        var sportFilterElem = document.getElementById('sportFilter');
        var categoryFilterElem = document.getElementById('categoryFilter');
        var statusFilterElem = document.getElementById('statusFilter');

        var searchText = searchInputElem ? searchInputElem.value.toLowerCase().trim() : '';
        var searchWords = searchText.length > 0 ? searchText.split(/\s+/).filter(Boolean) : [];
        var sport = sportFilterElem ? sportFilterElem.value.toLowerCase().trim() : '';
        var category = categoryFilterElem ? categoryFilterElem.value.toLowerCase().trim() : '';
        var status = statusFilterElem ? statusFilterElem.value.toLowerCase().trim() : '';
        var visibleCount = 0;

        $('.event-row').each(function() {
            var title = ($(this).attr('data-title') || $(this).find('.event-title-display').text()).toLowerCase();
            var rowSport = ($(this).attr('data-sport') || '').toLowerCase().trim();
            var rowCategory = ($(this).attr('data-category') || '').toLowerCase().trim();
            var rowDivision = ($(this).attr('data-division') || '').toLowerCase().trim();
            var rowStatus = ($(this).attr('data-status') || '').toLowerCase().trim();
            
            var isAssigned = $(this).attr('data-is-assigned') === 'true';

            // 1. Search Check (matches results that contain the search words in the event title)
            var matchSearch = searchWords.length === 0 || searchWords.every(function(word) {
                return title.indexOf(word) > -1;
            });

            // 2. Sport Check
            var matchSport = sport === "" || rowSport === sport;

            // 3. Division Check
            var currentDiv = currentDivisionFilter.toLowerCase().trim();
            var matchDivision = currentDiv === 'all'
                ? rowDivision === 'elementary' || rowDivision === 'secondary'
                : rowDivision === currentDiv;

            // 4. Status Check
            var isCompleted = rowStatus === "completed";
            var matchStatus = true;
            if (status === "completed") {
                matchStatus = isCompleted;
            } else if (status === "pending") {
                matchStatus = !isCompleted;
            }

            // 5. Assigned Filter Check
            var matchAssigned = !viewAssignedOnly || isAssigned;

            var matchCategory = category === '' || rowCategory === category;

            if (matchSearch && matchSport && matchCategory && matchDivision && matchStatus && matchAssigned) {
                $(this).show();
                visibleCount++;
            } else {
                $(this).hide();
            }
        });

        // Desktop vs Mobile inline background handling to ensure smooth animations on mobile
        if ($(window).width() > 768) {
            $('.event-row:visible').each(function(index) {
                $(this).css('background', (index % 2 === 1) ? 'rgba(57, 116, 71, 0.08)' : 'rgba(255, 255, 255, 0.45)');
            });
        } else {
            // Completely strip inline background properties on mobile so CSS animation rules run uninhibited
            $('.event-row').css('background', '');
            $('.event-row').css('background-color', '');
        }

        if (visibleCount === 0) {
            $('#noEventsRow').show();
            $('#eventsTable').hide();
        } else {
            $('#noEventsRow').hide();
            $('#eventsTable').show();
        }

        const activeCount = [sport, category, status].filter(Boolean).length;
        document.getElementById('eventFilterCount').textContent = activeCount ? ` (${activeCount})` : '';
        saveFilterState();
    }

    $(document).ready(function() {
        const sheet = document.getElementById('eventFiltersSheet');
        const fields = document.getElementById('eventFilterFields');
        const toggle = document.getElementById('eventFiltersToggle');
        const mobile = window.matchMedia('(max-width: 768px)');
        // Move the original controls, retaining their values and filter handlers.
        document.body.appendChild(sheet);
        function placeFilters() {
            if (!mobile.matches) bootstrap.Offcanvas.getInstance(sheet)?.hide();
            (mobile.matches ? sheet.querySelector('.offcanvas-body') : document.getElementById('eventFilterSlot')).appendChild(fields);
        }
        placeFilters();
        mobile.addEventListener('change', placeFilters);
        sheet.addEventListener('shown.bs.offcanvas', () => toggle.setAttribute('aria-expanded', 'true'));
        sheet.addEventListener('hidden.bs.offcanvas', () => toggle.setAttribute('aria-expanded', 'false'));
        document.getElementById('clearEventFilters').addEventListener('click', () => {
            ['sportFilter', 'categoryFilter', 'statusFilter'].forEach(id => document.getElementById(id).value = '');
            applyFilters();
        });
        loadFilterState();
        applyFilters();

        $(window).on('resize', function() {
            applyFilters();
        });
    });
</script>
}
