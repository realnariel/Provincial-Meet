@model ProvMeet.Models.Event
@{
    ViewData["Title"] = "Submit Results";
    var teams = ViewBag.Teams as List<ProvMeet.Models.Team> ?? new List<ProvMeet.Models.Team>();
    var returnUrl = ViewBag.ReturnUrl as string;
    
    // Retrieve the numerical CoordinatorId from the user's claims
    var currentCoordinatorIdStr = User.FindFirst("CoordinatorId")?.Value 
        ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? User.FindFirst("Id")?.Value;

    // Compare the Model's CoordinatorId against the Claim's CoordinatorId instead of the Username
    bool isAuthorized = User.Identity?.IsAuthenticated == true && 
        (User.IsInRole("Admin") || (Model.CoordinatorId != null && Model.CoordinatorId.ToString() == currentCoordinatorIdStr));
}

<style>
    /* ========================================== */
    /* MASTER OPACITY & COLOR CONTROL             */
    :root {
        --card-opacity: 1.0; 
    }
    /* ========================================== */

    body {
        background-color: var(--cc-background) !important; 
    }

    /* Animated Gradient Core Setup */
    @@keyframes gradientMove {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .glass-card { 
        background: white; 
        border-radius: var(--cc-radius-lg, 14px); 
        box-shadow: 0 10px 30px rgba(18, 63, 45, 0.08); 
        border: 1px solid rgba(18, 63, 45, 0.15);
        border-top: 5px solid var(--cc-gold, #C8A354); 
    }
    
    .form-control-custom { 
        border: 1px solid var(--cc-border, #D9DEE5); 
        border-radius: 6px; 
        font-family: var(--font-body, 'Inter', sans-serif);
        padding: 0.75rem 1rem;
    }
    
    .form-control-custom:focus { 
        border-color: var(--cc-primary, #123F2D); 
        box-shadow: 0 0 0 0.2rem rgba(18, 63, 45, 0.15); 
    }
    
    .modern-medal-box { 
        padding: 1.5rem; 
        border-radius: var(--cc-radius-lg, 14px); 
        background: #f8f9fa; 
        border: 1px solid rgba(18, 63, 45, 0.12);
        box-shadow: 0 4px 16px rgba(18, 63, 45, 0.04);
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    
    .medal-label {
        font-family: var(--font-body, 'Inter', sans-serif);
        font-weight: 800;
        font-size: 1.05rem;
        text-transform: uppercase;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-custom-primary {
        background: linear-gradient(135deg, var(--cc-primary, #123F2D) 0%, var(--cc-secondary, #397447) 100%);
        border: none;
        color: white;
        font-weight: 700;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(18, 63, 45, 0.2);
    }

    .btn-custom-primary:hover {
        opacity: 0.95;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(57, 116, 71, 0.3);
        color: white;
    }

    /* Progress Overlay Styling */
    #progressOverlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.85);
        z-index: 9999;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(4px);
    }
</style>

<!-- Fullscreen Progress Overlay -->
<div id="progressOverlay">
    <h4 id="progressText" class="mb-4 fw-bold" style="color: var(--cc-primary, #123F2D); font-family: var(--font-body);">Processing...</h4>
    <div class="progress w-75 rounded-pill shadow-sm" style="max-width: 400px; height: 1.5rem;">
        <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
    </div>
</div>

<div class="container py-4 py-md-5">
    
    <!-- Dynamic Back Button: Reloads Rankings if navigated from Recent Updates, otherwise returns to Events -->
    <div class="mb-4">
        @if (!string.IsNullOrEmpty(returnUrl))
        {
            <a href="@returnUrl" class="text-decoration-none text-muted fw-bold" style="font-size: 0.85rem; font-family: var(--font-body);"><i class="bi bi-arrow-left"></i> Back to Rankings</a>
        }
        else
        {
            <a asp-action="Index" class="text-decoration-none text-muted fw-bold" style="font-size: 0.85rem; font-family: var(--font-body);"><i class="bi bi-arrow-left"></i> Back to Events</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="glass-card p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
            <div>
                <h2 class="mb-1 fw-bold" style="font-family: var(--font-body); color: var(--cc-primary, #123F2D);">
                    <i class="bi bi-shield-check text-warning me-2"></i> @(isAuthorized ? "OFFICIAL SCORING" : "MATCH RESULTS")
                </h2>
                <div class="d-flex gap-2 align-items-center mt-2 flex-wrap">
                    <span class="badge px-3 py-2 fw-bold" style="background: var(--cc-primary, #123F2D); color: white;">@Model.Division</span>
                    <span class="badge px-3 py-2 fw-bold bg-light text-dark border">@Model.SportName</span>
                    <span class="fs-5 text-dark fw-bold" style="font-family: var(--font-body);">@Model.Title</span>
                </div>
            </div>
            @if(Model.Status == "Completed"){
                <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">COMPLETED</span>
            }
        </div>
        
        @if (!string.IsNullOrEmpty(Model.LastUpdatedBy)) {
            <div class="mb-4 p-3 rounded-3" style="background: rgba(18, 63, 45, 0.04); border: 1px solid rgba(18, 63, 45, 0.1);">
                <i class="bi bi-info-circle text-primary"></i> <span class="text-muted fw-bold" style="font-size: 0.85rem; font-family: var(--font-body);">Last updated by: <span class="text-dark">@Model.LastUpdatedBy</span> 
                @if (Model.UpdatedAt.HasValue) { <span>on @DateTime.SpecifyKind(Model.UpdatedAt.Value, DateTimeKind.Utc).AddHours(8).ToString("MMM dd, yyyy h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span> }</span>
            </div>
        }
        
        <form id="submitResultsForm" asp-action="SubmitResults" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="row g-4 mb-5">
                <!-- GOLD -->
                <div class="col-md-4">
                    <div class="modern-medal-box" style="border-top: 5px solid #D4AF37;">
                        <label class="medal-label" style="color: #997A15;"><span>🥇</span> Gold Medalist</label>
                        <select asp-for="GoldTeamId" class="form-select form-control-custom mb-3" disabled="@(!isAuthorized)">
                            <option value="">-- Select Winning Team --</option>
                            @foreach(var t in teams){<option value="@t.Id">@t.Name</option>}
                        </select>
                        <textarea asp-for="GoldWinnerName" class="form-control form-control-custom flex-grow-1" placeholder="@(isAuthorized ? "Athlete Name(s)\nPress Enter for next line" : "")" rows="3" readonly="@(!isAuthorized)"></textarea>
                    </div>
                </div>
                <!-- SILVER -->
                <div class="col-md-4">
                    <div class="modern-medal-box" style="border-top: 5px solid #949494;">
                        <label class="medal-label" style="color: #6c757d;"><span>🥈</span> Silver Medalist</label>
                        <select asp-for="SilverTeamId" class="form-select form-control-custom mb-3" disabled="@(!isAuthorized)">
                            <option value="">-- Select Runner-up --</option>
                            @foreach(var t in teams){<option value="@t.Id">@t.Name</option>}
                        </select>
                        <textarea asp-for="SilverWinnerName" class="form-control form-control-custom flex-grow-1" placeholder="@(isAuthorized ? "Athlete Name(s)\nPress Enter for next line" : "")" rows="3" readonly="@(!isAuthorized)"></textarea>
                    </div>
                </div>
                <!-- BRONZE -->
                <div class="col-md-4">
                    <div class="modern-medal-box" style="border-top: 5px solid #CD7F32;">
                        <label class="medal-label" style="color: #A05A2C;"><span>🥉</span> Bronze Medalist</label>
                        <select asp-for="BronzeTeamId" class="form-select form-control-custom mb-3" disabled="@(!isAuthorized)">
                            <option value="">-- Select 3rd Place --</option>
                            @foreach(var t in teams){<option value="@t.Id">@t.Name</option>}
                        </select>
                        <textarea asp-for="BronzeWinnerName" class="form-control form-control-custom flex-grow-1" placeholder="@(isAuthorized ? "Athlete Name(s)\nPress Enter for next line" : "")" rows="3" readonly="@(!isAuthorized)"></textarea>
                    </div>
                </div>
            </div>
            
            <!-- Inside the form actions section -->
            @if (isAuthorized) {
                <div class="d-flex flex-column flex-sm-row justify-content-between pt-4 align-items-center gap-3" style="border-top: 1px solid #dee2e6;">
                    <div class="d-flex gap-2 flex-wrap mb-3 mb-sm-0">
                        <button type="button" class="btn btn-outline-danger fw-bold rounded-pill px-4" onclick="confirmClear()">Clear All Data</button>
                        
                        @if (Model.GoldTeamId.HasValue || Model.SilverTeamId.HasValue || Model.BronzeTeamId.HasValue)
                        {
                            <a asp-controller="Delegation" asp-action="Manage" asp-route-eventId="@Model.Id" class="btn btn-outline-success fw-bold rounded-pill px-4">
                                <i class="bi bi-people-fill"></i> Manage Delegation
                            </a>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-custom-primary fw-bold px-5 py-2 rounded-pill shadow-sm"><span>Publish Official Results</span></button>
                    </div>
                </div>
            }
        </form>
        @if (isAuthorized) { 
            <form id="clearForm" asp-action="ClearResults" method="post" style="display:none;">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            </form> 
        }
    </div>
</div>

@section Scripts { 
    @if (isAuthorized)
    {
        <script type="application/json" id="winner-name-options">@Json.Serialize(ViewBag.WinnerNames ?? new List<string>())</script>
        <script src="~/js/winner-name-suggestions.js" asp-append-version="true"></script>
    }
    <script> 
        document.addEventListener('DOMContentLoaded', function() {
            const submitResultsForm = document.getElementById('submitResultsForm');
            const overlay = document.getElementById('progressOverlay');
            const progressText = document.getElementById('progressText');
            const progressBar = document.getElementById('progressBar');

            function showProgress(text, colorClass) {
                progressText.innerText = text;
                progressBar.className = 'progress-bar progress-bar-striped progress-bar-animated ' + colorClass;
                overlay.style.display = 'flex';
            }

            // Hook into the main publish form
            if (submitResultsForm) {
                submitResultsForm.addEventListener('submit', function(e) {
                    if (confirm('Are you sure you want to publish these official results?')) {
                        showProgress('Publishing official results...', 'bg-primary');
                    } else {
                        e.preventDefault();
                    }
                });
            }

            // Global confirmation and progress for clearing data
            window.confirmClear = function() { 
                if (confirm('Are you sure you want to remove all results for this event? This will reset the medal tally for the involved teams.')) { 
                    showProgress('Clearing event data...', 'bg-danger');
                    document.getElementById('clearForm').submit(); 
                } 
            };
        });
    </script> 
}
