@model IEnumerable<ProvMeet.Models.Event>
@{
    ViewData["Title"] = "Manage Events";
    var coordinators = ViewBag.Coordinators as List<ProvMeet.Models.Coordinator> ?? new List<ProvMeet.Models.Coordinator>();
}

<style>
    /* ========================================== */
    /* MASTER OPACITY & COLOR CONTROL             */
    :root {
        --card-opacity: 1.0; 
    }
    /* ========================================== */

    body {
        background-color: var(--cc-background) !important; 
    }

    /* Animated Gradient Core Setup */
    @@keyframes gradientMove {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .page-header {
        color: var(--cc-primary, #123F2D);
        border-bottom: 3px solid var(--cc-gold, #C8A354);
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }
    .page-header h1 {
        color: var(--cc-primary, #123F2D);
    }

    .glass-card { 
        background: white; 
        border-radius: var(--cc-radius-lg, 14px); 
        box-shadow: 0 10px 30px rgba(18, 63, 45, 0.08); 
        border: 1px solid rgba(18, 63, 45, 0.15);
        border-top: 5px solid var(--cc-gold, #C8A354); 
    }

    .minimalist-table th {
        font-family: var(--font-body, 'Inter', sans-serif);
        background: linear-gradient(-45deg, 
            rgba(18, 63, 45, var(--card-opacity)) 0%, 
            rgba(9, 45, 32, var(--card-opacity)) 65%, 
            rgba(57, 116, 71, var(--card-opacity)) 90%, 
            rgba(18, 63, 45, var(--card-opacity)) 100%);
        background-size: 300% 300%;
        animation: gradientMove 12s ease-in-out infinite;
        color: #ffffff;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        padding: 14px 16px;
        letter-spacing: 0.5px;
        border: none;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .minimalist-table tbody td {
        padding: 1rem 16px;
        vertical-align: middle;
        border-bottom: 1px solid #dee2e6;
        font-family: var(--font-body, 'Inter', sans-serif);
    }
    
    .form-control-custom { 
        border: 1px solid var(--cc-border, #D9DEE5); 
        border-radius: 6px; 
        font-family: var(--font-body, 'Inter', sans-serif);
        padding: 0.75rem 1rem;
    }

    .form-control-custom:focus {
        border-color: var(--cc-primary, #123F2D);
        box-shadow: 0 0 0 0.2rem rgba(18, 63, 45, 0.15);
    }
    
    .filter-bar {
        background: #f8f9fa;
        padding: 1.25rem;
        border-bottom: 1px solid rgba(18, 63, 45, 0.1);
    }

    .btn-custom-primary {
        background: linear-gradient(135deg, var(--cc-primary, #123F2D) 0%, var(--cc-secondary, #397447) 100%);
        border: none;
        color: white;
        font-weight: 700;
        padding: 0.5rem 1.25rem;
        border-radius: 6px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(18, 63, 45, 0.2);
        font-family: var(--font-body, 'Inter', sans-serif);
        font-size: 0.85rem;
    }

    .btn-custom-primary:hover {
        opacity: 0.95;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(57, 116, 71, 0.3);
        color: white;
    }

    /* Strict Desktop View Alternating Rows with Theme Tint */
    @@media (min-width: 769px) {
        .minimalist-table tbody tr {
            background-color: #ffffff;
        }
        .minimalist-table tbody tr:nth-child(even) {
            background-color: rgba(57, 116, 71, 0.03);
        }
        .minimalist-table tbody tr:hover {
            background-color: rgba(18, 63, 45, 0.06) !important;
        }
    }

    /* Mobile Responsive Card View */
    @@media (max-width: 768px) {
        .minimalist-table thead { display: none; }
        
        .minimalist-table tbody tr { 
            display: flex; 
            flex-direction: column;
            margin-bottom: 1.25rem; 
            padding: 1.25rem; 
            background: linear-gradient(-45deg, 
                rgba(18, 63, 45, var(--card-opacity)) 0%, 
                rgba(9, 45, 32, var(--card-opacity)) 65%, 
                rgba(57, 116, 71, var(--card-opacity)) 90%, 
                rgba(18, 63, 45, var(--card-opacity)) 100%) !important; 
            background-size: 300% 300%;
            animation: gradientMove 12s ease-in-out infinite;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-left: 5px solid var(--cc-gold, #C8A354) !important;
            border-radius: var(--cc-radius-lg, 14px); 
            box-shadow: 0 8px 24px rgba(18, 63, 45, 0.2);
            gap: 0.75rem; 
            color: #ffffff;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        
        .minimalist-table tbody td { 
            display: flex; 
            flex-direction: column;
            align-items: flex-start;
            padding: 0 !important; 
            border: none !important; 
            width: 100%;
        }
        
        /* High-contrast labels */
        .minimalist-table tbody td::before { 
            content: attr(data-label); 
            color: var(--cc-gold-light, #F5E3A1); 
            font-weight: 700; 
            font-size: 0.75rem; 
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.3rem;
        }

        /* Contrast overrides for title, badges, and small text */
        .minimalist-table tbody tr .event-title {
            color: #ffffff !important;
        }

        .minimalist-table tbody tr .badge {
            background: rgba(255, 255, 255, 0.2) !important;
            color: #ffffff !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
        }

        .minimalist-table tbody tr small.text-muted {
            color: rgba(255, 255, 255, 0.75) !important;
        }

        .minimalist-table tbody td.classification-cell::before { display: none; }
        .minimalist-table tbody td.classification-cell {
            flex-direction: row;
            align-items: center;
            flex-wrap: nowrap;
            gap: 8px;
            white-space: nowrap;
            overflow: hidden;
        }
        .minimalist-table tbody td.classification-cell .badge {
            display: inline-flex;
            align-items: center;
            font-size: .9rem;
            line-height: 1.2;
            padding: 6px 10px !important;
            flex: 0 1 auto;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .classification-separator { color: var(--cc-gold-light, #F5E3A1); font-size: 1.25rem; font-weight: 800; flex: 0 0 auto; }
        
        .minimalist-table tbody td[data-label="Event"] {
            margin-bottom: 0.25rem;
        }
        
        .minimalist-table tbody td[data-label="Action"]::before {
            display: none;
        }
        
        .minimalist-table tbody td[data-label="Action"] { 
            border-top: 1px dashed rgba(255, 255, 255, 0.3) !important; 
            margin-top: 0.5rem; 
            padding-top: 0.75rem !important; 
            flex-direction: row;
            justify-content: flex-end;
            gap: 8px;
        }
        
        .minimalist-table tbody tr .btn-outline-primary {
            color: #ffffff !important;
            border-color: #ffffff !important;
        }

        .minimalist-table tbody tr .btn-outline-primary:hover {
            background-color: #ffffff !important;
            color: var(--cc-primary, #123F2D) !important;
        }

        .minimalist-table tbody tr .btn-outline-danger {
            color: #ff9999 !important;
            border-color: #ff9999 !important;
        }

        .minimalist-table tbody tr .btn-outline-danger:hover {
            background-color: #dc3545 !important;
            color: #ffffff !important;
            border-color: #dc3545 !important;
        }

        .action-btn {
            padding: 0.4rem 0.8rem !important;
        }
    }
</style>

<div class="container py-4 py-md-5">
    
    <div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
        <div>
            <h1 class="display-6 fw-bold mb-1" style="font-family: var(--font-body);">
                <i class="bi bi-sliders text-warning"></i> EVENT MANAGEMENT
            </h1>
            <p class="fs-6 text-muted mb-0 fw-bold" style="font-family: var(--font-body);">Administer events, divisions, and coordinators</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-custom-primary shadow-sm"><span><i class="bi bi-plus-lg"></i> Add Event</span></a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="status">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="glass-card p-0 overflow-hidden">
        
        @if (Model.Any()) {
            <div class="filter-bar row g-3 m-0">
                <div class="col-md-4">
                    <input type="search" id="searchEventInput" class="form-control form-control-custom" placeholder="Search event title..." aria-label="Search event titles">
                </div>
                <div class="col-md-4">
                    <select id="divisionFilter" class="form-select form-control-custom" aria-label="Filter events by division">
                        <option value="">All Divisions</option>
                        <option value="Elementary">Elementary</option>
                        <option value="Secondary">Secondary</option>
                        <option value="Paragames">Paragames</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select id="sportFilter" class="form-select form-control-custom" aria-label="Filter events by sport">
                        <option value="">All Sports</option>
                        @foreach(var sport in Model.Select(e => e.SportName).Distinct().OrderBy(s => s)) { 
                            <option value="@sport">@sport</option> 
                        }
                    </select>
                </div>
            </div>
        }

        @if (!Model.Any()) { 
            <div class="text-center py-5 bg-white"><p class="mb-0 text-muted fw-bold">No events have been created yet.</p></div> 
        }
        else {
            <form asp-action="UpdateAllEventCoordinators" method="post" id="coordinatorAssignmentsForm">
                <div class="table-responsive p-3">
                    <table class="minimalist-table w-100 mb-0" id="manageEventsTable">
                        <thead>
                            <tr>
                                <th style="width: 25%;">Classification</th>
                                <th style="width: 30%;">Event Title</th>
                                <th style="width: 25%;">Assigned Coordinator</th>
                                <th class="text-end" style="width: 20%;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in Model) {
                                <tr data-sport="@ev.SportName" data-division="@ev.Division" class="event-management-row">
                                    <td data-label="" class="classification-cell">
                                        <span class="badge px-2 py-1" style="background: var(--cc-primary, #123F2D); color: white;">@ev.Division</span>
                                        <span class="classification-separator" aria-hidden="true">›</span>
                                        <span class="badge bg-light text-dark border">@ev.SportName</span>
                                    </td>
                                    <td data-label="Event">
                                        <span class="event-title fw-bold" style="font-family: var(--font-body); color: var(--cc-primary, #123F2D); font-size: 1.05rem;">@ev.Title</span>
                                    </td>
                                    <td data-label="Coordinator">
                                        <select name="assignments[@ev.Id]" class="form-select form-select-sm form-control-custom w-100">
                                            <option value="">-- No Coordinator --</option>
                                            @foreach (var coordinator in coordinators) {
                                                if (ev.CoordinatorId.HasValue && ev.CoordinatorId.Value == coordinator.Id) { 
                                                    <option value="@coordinator.Id" selected>@coordinator.FullName</option> 
                                                }
                                                else { 
                                                    <option value="@coordinator.Id">@coordinator.FullName</option> 
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td class="text-end" data-label="Action">
                                        <a asp-action="Edit" asp-route-id="@ev.Id" class="btn action-btn btn-sm btn-outline-primary fw-bold rounded-pill px-3" title="Edit">
                                            <i class="bi bi-pencil-square"></i><span class="d-none d-md-inline ms-1">Edit</span>
                                        </a>
                                        <button type="button" class="btn action-btn btn-sm btn-outline-danger fw-bold rounded-pill px-3 ms-1" onclick="confirmDelete(@ev.Id)" title="Delete">
                                            <i class="bi bi-trash"></i><span class="d-none d-md-inline ms-1">Delete</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end p-3 bg-light border-top">
                    <button type="submit" id="saveCoordinatorAssignments" class="btn btn-custom-primary" style="background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);">
                        <span class="save-label"><i class="bi bi-save"></i> Save Coordinator Assignments</span>
                        <span class="saving-label d-none"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Saving...</span>
                    </button>
                </div>
            </form>
        }
    </div>
</div>

<form id="deleteForm" method="post" asp-action="Delete">
    <input type="hidden" id="deleteEventId" name="id" value="" />
</form>

@section Scripts { 
    <script> 
        function confirmDelete(eventId) { 
            if (confirm('Are you certain you wish to delete this event? This will permanently erase any scores associated with it.')) { 
                document.getElementById('deleteEventId').value = eventId; 
                document.getElementById('deleteForm').submit(); 
            } 
        } 

        function saveManageEventsFilterState() {
            try {
                const state = {
                    search: document.getElementById('searchEventInput')?.value || '',
                    division: document.getElementById('divisionFilter')?.value || '',
                    sport: document.getElementById('sportFilter')?.value || ''
                };
                sessionStorage.setItem('prov_manage_events_filters', JSON.stringify(state));
            } catch (e) {}
        }

        function loadManageEventsFilterState() {
            try {
                const saved = sessionStorage.getItem('prov_manage_events_filters');
                if (!saved) return;
                const state = JSON.parse(saved);
                if (state.search !== undefined) {
                    const input = document.getElementById('searchEventInput');
                    if (input) input.value = state.search;
                }
                if (state.division !== undefined) {
                    const divSelect = document.getElementById('divisionFilter');
                    if (divSelect) divSelect.value = state.division;
                }
                if (state.sport !== undefined) {
                    const sportSelect = document.getElementById('sportFilter');
                    if (sportSelect) sportSelect.value = state.sport;
                }
            } catch (e) {}
        }

        let filterFrame = null;
        function filterManageEvents(saveState = true) {
            // Use pure Vanilla JS for better performance and to remove jQuery dependency
            const searchInput = document.getElementById('searchEventInput');
            const sportSelect = document.getElementById('sportFilter');
            const divisionSelect = document.getElementById('divisionFilter');

            const searchText = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const sport = sportSelect ? sportSelect.value : '';
            const division = divisionSelect ? divisionSelect.value : '';
            const rows = document.querySelectorAll('.event-management-row');

            rows.forEach(row => {
                const title = row.querySelector('.event-title')?.textContent.toLowerCase() || '';
                const rowSport = row.getAttribute('data-sport') || '';
                const rowDiv = row.getAttribute('data-division') || '';

                const matchSearch = title.includes(searchText);
                const matchSport = sport === "" || rowSport === sport;
                const matchDivision = division === "" || rowDiv === division;

                if (matchSearch && matchSport && matchDivision) {
                    if (window.innerWidth <= 768) {
                        row.style.display = 'flex'; // Mobile card view
                    } else {
                        row.style.display = 'table-row'; // Desktop table view
                    }
                } else {
                    row.style.display = 'none';
                }
            });

            if (saveState) saveManageEventsFilterState();
        }

        function scheduleManageEventsFilter(saveState = true) {
            if (filterFrame !== null) cancelAnimationFrame(filterFrame);
            filterFrame = requestAnimationFrame(() => {
                filterManageEvents(saveState);
                filterFrame = null;
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadManageEventsFilterState();
            filterManageEvents(false);

            document.getElementById('searchEventInput')?.addEventListener('input', () => scheduleManageEventsFilter());
            document.getElementById('divisionFilter')?.addEventListener('change', () => scheduleManageEventsFilter());
            document.getElementById('sportFilter')?.addEventListener('change', () => scheduleManageEventsFilter());

            const assignmentsForm = document.getElementById('coordinatorAssignmentsForm');
            assignmentsForm?.addEventListener('submit', function() {
                const button = document.getElementById('saveCoordinatorAssignments');
                if (!button) return;
                button.disabled = true;
                button.querySelector('.save-label')?.classList.add('d-none');
                button.querySelector('.saving-label')?.classList.remove('d-none');
            });
        });

        window.addEventListener('resize', () => scheduleManageEventsFilter(false));
    </script> 
}
