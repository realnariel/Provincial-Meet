@model ProvMeet.Models.PlayerMedalReportViewModel
@{
    ViewData["Title"] = Model.ShowEvents ? "Player Event Report" : "Player Medal Report";
    var reportAction = Model.ShowEvents ? "Events" : "Index";
}
<style>
    .player-report { color: #123F2D; }
    .player-report .report-sheet { background: white; border-radius: 12px; padding: clamp(16px, 3vw, 32px); }
    .player-report th { white-space: nowrap; }
    @@media print {
        header, nav, footer, .offcanvas, .report-controls { display: none !important; }
        body, .player-report, .report-sheet { background: white !important; color: black !important; }
        .player-report { max-width: none; padding: 0 !important; }
        .table-responsive { overflow: visible; }
        thead { display: table-header-group; }
        tr { break-inside: avoid; }
    }
</style>
<div class="container py-4 player-report">
    <div class="report-sheet">
        <h1 class="h3 fw-bold">@ViewData["Title"]</h1>
        <p>Bohol Provincial Athletic Meet 2026</p>
        <div class="report-controls d-flex flex-wrap gap-2 mb-3">
            <a asp-action="Index" asp-route-sport="@Model.Sport" asp-route-sportType="@Model.SportType" asp-route-category="@Model.Category" asp-route-player="@Model.Player" asp-route-team="@Model.Team" asp-route-division="@Model.Division" asp-route-exactPlayer="@Model.ExactPlayer" class="btn btn-outline-primary">Medal totals</a>
            <a asp-action="Events" asp-route-sport="@Model.Sport" asp-route-sportType="@Model.SportType" asp-route-category="@Model.Category" asp-route-player="@Model.Player" asp-route-team="@Model.Team" asp-route-division="@Model.Division" asp-route-exactPlayer="@Model.ExactPlayer" class="btn btn-outline-primary">Events won</a>
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print / Save PDF</button>
        </div>
        <form method="get" asp-action="@reportAction" class="row g-3 mb-4 report-controls">
            <div class="col-12 col-md-4">
                <label asp-for="Player" class="form-label">Search player</label>
                <input asp-for="Player" class="form-control" list="playerNames" placeholder="Type a player name" />
                <datalist id="playerNames">@foreach (var name in Model.Players) { <option value="@name"></option> }</datalist>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="Sport" class="form-label">Sport</label>
                <select asp-for="Sport" class="form-select"><option value="">All sports</option>@foreach (var sport in Model.Sports) { <option value="@sport">@sport</option> }</select>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="SportType" class="form-label">Type</label>
                <select asp-for="SportType" class="form-select"><option value="">All types</option>@foreach (var type in Model.SportTypes) { <option value="@type">@type</option> }</select>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="Category" class="form-label">Category</label>
                <select asp-for="Category" class="form-select"><option value="">All categories</option>@foreach (var category in new[] { "Boys", "Girls", "Mixed", "Unspecified" }) { <option value="@category">@category</option> }</select>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="Division" class="form-label">Division</label>
                <select asp-for="Division" class="form-select"><option value="">All divisions</option>@foreach (var division in Model.Divisions) { <option value="@division">@division</option> }</select>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Team" class="form-label">Team</label><input asp-for="Team" class="form-control" placeholder="All teams" />
            </div>
            <div class="col-12 d-flex gap-2 align-items-center flex-wrap">
                <label><input asp-for="ExactPlayer" class="form-check-input me-1" /> Exact player name</label>
                <button class="btn btn-primary" type="submit">Apply filters</button>
                <a asp-action="@reportAction" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
        <p class="small text-muted">Filters: @(Model.Sport ?? "All sports") · @(Model.SportType ?? "All types") · @(Model.Category ?? "All categories") · @(Model.Division ?? "All divisions") · @(Model.Player ?? "All players") · @(Model.Team ?? "All teams")</p>
        <div class="row row-cols-2 row-cols-md-4 g-2 mb-3">
            <div class="col"><div class="border rounded p-3"><strong>Gold</strong><div class="fs-4">@Model.Entries.Count(x => x.Medal == "Gold")</div></div></div>
            <div class="col"><div class="border rounded p-3"><strong>Silver</strong><div class="fs-4">@Model.Entries.Count(x => x.Medal == "Silver")</div></div></div>
            <div class="col"><div class="border rounded p-3"><strong>Bronze</strong><div class="fs-4">@Model.Entries.Count(x => x.Medal == "Bronze")</div></div></div>
            <div class="col"><div class="border rounded p-3"><strong>Total</strong><div class="fs-4">@Model.Entries.Count</div></div></div>
        </div>
        <p class="small">Each named player receives one medal per recorded podium result, including team events. Repeated names on the same result are counted once. Players are identified by name, team, and division.</p>
        @if (!Model.Entries.Any()) { <div class="alert alert-info">No player medals match these filters.</div> }
        @foreach (var category in new[] { "Boys", "Girls", "Mixed", "Unspecified" }) {
            var entries = Model.Entries.Where(x => x.Category == category).ToList();
            if (!entries.Any()) { continue; }
            <h2 class="h5 mt-4">@category</h2>
            <p class="small">Gold: @entries.Count(x => x.Medal == "Gold") · Silver: @entries.Count(x => x.Medal == "Silver") · Bronze: @entries.Count(x => x.Medal == "Bronze")</p>
            <div class="table-responsive">
                @if (Model.ShowEvents) {
                    <table class="table table-bordered align-middle">
                        <thead><tr><th>Medal</th><th>Player</th><th>Team</th><th>Division</th><th>Sport</th><th>Type</th><th>Event won</th></tr></thead>
                        <tbody>@foreach (var entry in entries) {
                            <tr><td>@entry.Medal</td><td>@entry.Player</td><td>@entry.Team</td><td>@entry.Division</td><td>@entry.Sport</td><td>@entry.SportType</td><td>@entry.EventTitle</td></tr>
                        }</tbody>
                    </table>
                } else {
                    var players = entries.GroupBy(x => new { Name = x.Player.ToUpperInvariant(), Team = x.Team.ToUpperInvariant(), Division = x.Division.ToUpperInvariant() })
                        .Select(g => new { Player = g.First(), Gold = g.Count(x => x.Medal == "Gold"), Silver = g.Count(x => x.Medal == "Silver"), Bronze = g.Count(x => x.Medal == "Bronze") })
                        .OrderByDescending(x => x.Gold).ThenByDescending(x => x.Silver).ThenByDescending(x => x.Bronze).ThenBy(x => x.Player.Player);
                    <table class="table table-bordered align-middle">
                        <thead><tr><th>Player</th><th>Team</th><th>Division</th><th>Gold</th><th>Silver</th><th>Bronze</th><th>Total</th><th class="report-controls">Details</th></tr></thead>
                        <tbody>@foreach (var row in players) {
                            <tr><td>@row.Player.Player</td><td>@row.Player.Team</td><td>@row.Player.Division</td><td>@row.Gold</td><td>@row.Silver</td><td>@row.Bronze</td><td>@(row.Gold + row.Silver + row.Bronze)</td>
                                <td class="report-controls"><a asp-action="Events" asp-route-player="@row.Player.Player" asp-route-exactPlayer="true" asp-route-team="@row.Player.Team" asp-route-division="@row.Player.Division" asp-route-category="@category" asp-route-sport="@Model.Sport" asp-route-sportType="@Model.SportType">Events won</a></td></tr>
                        }</tbody>
                    </table>
                }
            </div>
        }
    </div>
</div>
