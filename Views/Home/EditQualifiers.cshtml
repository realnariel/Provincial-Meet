@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<ProvMeet.Models.EventQualifier>
@{
    ViewData["Title"] = "Manage & Edit Qualifiers";
    var eventsList = ViewBag.AllEvents as List<ProvMeet.Models.Event> ?? new List<ProvMeet.Models.Event>();
    var teamsList = ViewBag.TeamsList as List<ProvMeet.Models.Team> ?? new List<ProvMeet.Models.Team>();
    var eventsById = eventsList.ToDictionary(e => (long)e.Id);

    var selectedSports = Context.Request.Query["sportsName"].ToList();
    var selectedEvents = Context.Request.Query["eventId"].ToList();
    var selectedDivisions = Context.Request.Query["division"].ToList();
    var selectedTeams = Context.Request.Query["team"].ToList();

    var tShirtSizes = new List<string> { "12", "14", "16", "18", "20", "XXS", "XS", "S", "M", "L", "XL", "2XL", "3XL" };
}

<!-- Include Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .setup-card {
        background-color: #ffffff;
        border: 1px solid rgba(0, 51, 160, 0.15);
        border-top: 4px solid var(--deped-blue, #123F2D);
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0, 51, 160, 0.08);
    }

    .table-edit-custom th {
        background: linear-gradient(135deg, #0056b3 0%, #123F2D 100%);
        color: #ffffff;
        font-family: var(--font-header, 'Poppins', sans-serif);
        font-size: 0.78rem;
        text-transform: uppercase;
        padding: 12px 10px;
        border: none;
        vertical-align: middle;
    }

    .table-edit-custom td {
        padding: 10px;
        vertical-align: middle;
        font-family: var(--font-body, 'Inter', sans-serif);
        border-bottom: 1px solid #dee2e6;
    }

    /* Mobile Responsive Card Transformation */
    @@media (max-width: 768px) {
        .edit-table thead { display: none; }
        
        .edit-table tbody tr {
            display: flex;
            flex-direction: column;
            background: #ffffff !important;
            border: 1px solid #dee2e6;
            border-left: 5px solid var(--deped-blue, #123F2D) !important;
            border-radius: 12px;
            margin-bottom: 1.25rem;
            padding: 1.25rem;
            box-shadow: 0 4px 15px rgba(0, 51, 160, 0.1);
            gap: 0.75rem;
        }
        
        .edit-table tbody td {
            display: flex;
            flex-direction: column;
            width: 100%;
            border: none !important;
            padding: 0 !important;
            text-align: left !important;
        }
        
        .edit-table tbody td::before {
            content: attr(data-label);
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            color: var(--deped-blue, #123F2D);
            margin-bottom: 3px;
        }

        .edit-table tbody td.mobile-select-row {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 51, 160, 0.04);
            padding: 8px 12px !important;
            border-radius: 8px;
        }
        
        .edit-table tbody td.mobile-select-row::before {
            content: "Select Row";
            margin-bottom: 0;
        }
    }
</style>

<div class="container py-4 py-md-5">
    
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <a asp-action="DistrictQualifierReport" class="text-decoration-none text-muted fw-bold" style="font-size: 0.85rem;"><i class="bi bi-arrow-left"></i> Back to Report Preview</a>
            <h2 class="fw-bold mt-1" style="font-family: var(--font-header); color: var(--deped-blue);">
                <i class="bi bi-people-fill text-warning me-2"></i> Edit & Manage Qualifiers
            </h2>
        </div>
        <button type="button" class="btn btn-primary fw-bold px-4 shadow-sm" style="background-color: var(--deped-blue);" data-bs-toggle="modal" data-bs-target="#qualifierModal">
            <i class="bi bi-plus-lg"></i> Add New Participant
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FILTER CARD -->
    <div class="card setup-card p-4 mb-4">
        <h5 class="fw-bold mb-3 border-bottom pb-2" style="color: #123F2D;">
            <i class="bi bi-filter-circle"></i> Filter List
        </h5>
        <form method="get" asp-action="EditQualifiers" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Filter by Sports</label>
                    <select name="sportsName" class="form-select select2-multi" multiple="multiple" data-placeholder="-- All Sports --">
                        @if (ViewBag.SportsList != null)
                        {
                            foreach (var sport in (List<SelectListItem>)ViewBag.SportsList)
                            {
                                if (selectedSports.Contains(sport.Value)) { <option value="@sport.Value" selected>@sport.Text</option> }
                                else { <option value="@sport.Value">@sport.Text</option> }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Filter by Event</label>
                    <select name="eventId" class="form-select select2-multi" multiple="multiple" data-placeholder="-- All Events --">
                        @if (ViewBag.EventsList != null)
                        {
                            foreach (var evt in (List<SelectListItem>)ViewBag.EventsList)
                            {
                                if (selectedEvents.Contains(evt.Value)) { <option value="@evt.Value" selected>@evt.Text</option> }
                                else { <option value="@evt.Value">@evt.Text</option> }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Filter by Division</label>
                    <select name="division" class="form-select select2-multi" multiple="multiple" data-placeholder="-- All Divisions --">
                        @if (ViewBag.DivisionsList != null)
                        {
                            foreach (var div in (List<SelectListItem>)ViewBag.DivisionsList)
                            {
                                if (selectedDivisions.Contains(div.Value)) { <option value="@div.Value" selected>@div.Text</option> }
                                else { <option value="@div.Value">@div.Text</option> }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Filter by Team</label>
                    <select name="team" class="form-select select2-multi" multiple="multiple" data-placeholder="-- All Teams --">
                        @if (ViewBag.TeamNamesList != null)
                        {
                            foreach (var sch in (List<SelectListItem>)ViewBag.TeamNamesList)
                            {
                                if (selectedTeams.Contains(sch.Value)) { <option value="@sch.Value" selected>@sch.Text</option> }
                                else { <option value="@sch.Value">@sch.Text</option> }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-12 text-end mt-3">
                    <a asp-action="EditQualifiers" asp-route-reset="true" class="btn btn-outline-secondary btn-sm px-3 fw-bold me-2" onclick="try { sessionStorage.removeItem('prov_edit_qualifiers_query'); } catch(e){}">Reset Filters</a>
                    <button type="submit" class="btn text-white shadow-sm px-4 fw-bold" style="background-color: #123F2D;">Apply Filters</button>
                </div>
            </div>
        </form>
    </div>

    <!-- UNIFIED BULK EDIT & DELETE FORM -->
    <form method="post" id="bulkActionForm">
        @Html.AntiForgeryToken()
        
        <!-- TOP ACTION BAR -->
        <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border">
            <div>
                <span class="fw-bold text-dark" style="font-size: 0.9rem;">
                    <i class="bi bi-info-circle text-primary"></i> Modify rows inline below, then click <strong>Save All Changes</strong>.
                </span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" asp-action="BulkDeleteQualifiers" class="btn btn-outline-danger fw-bold btn-sm px-3" onclick="return confirm('Are you sure you want to delete all selected participants?');">
                    <i class="bi bi-trash"></i> Delete Selected
                </button>
                <button type="submit" asp-action="BulkSaveQualifiers" class="btn text-white fw-bold btn-sm px-4" style="background-color: var(--deped-blue);">
                    <i class="bi bi-save"></i> Save All Changes
                </button>
            </div>
        </div>

        <!-- TABLE CONTAINER -->
        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <div class="table-responsive">
                <table class="table table-edit-custom edit-table w-100 mb-0 align-middle">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 35px; min-width: 35px;">
                                <input type="checkbox" id="selectAll" class="form-check-input" onclick="toggleSelectAll(this)" />
                            </th>
                            <th style="width: 26%;">Participant Name & Team</th>
                            <th style="width: 33%;">Event & Sport</th>
                            <th style="width: 18%;">Role</th>
                            <th style="width: 14%;">T-Shirt Size</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted fw-bold">No qualifier participants found matching your criteria.</td>
                            </tr>
                        }
                        else
                        {
                            int index = 0;
                            foreach (var q in Model)
                            {
                                eventsById.TryGetValue(q.EventId, out var evt);
                                <tr>
                                    <td class="text-center mobile-select-row" style="width: 35px;">
                                        <input type="checkbox" name="selectedIds" value="@q.Id" class="form-check-input row-checkbox" />
                                        <input type="hidden" name="qualifiers[@index].Id" value="@q.Id" />
                                    </td>
                                    <td data-label="Participant Name & Team">
                                        <input type="text" name="qualifiers[@index].ParticipantName" value="@q.ParticipantName" class="form-control form-control-sm fw-bold mb-2" required placeholder="Participant Name" />
                                        <select name="qualifiers[@index].Team" class="form-select form-select-sm">
                                            <option value="">-- Select Team --</option>
                                            @foreach(var t in teamsList)
                                            {
                                                if (q.Team == t.Name) { <option value="@t.Name" selected>@t.Name</option> }
                                                else { <option value="@t.Name">@t.Name</option> }
                                            }
                                        </select>
                                    </td>
                                    <td data-label="Event & Sport">
                                        <select name="qualifiers[@index].EventId" class="form-select form-select-sm deferred-event-select" required>
                                            <option value="">-- Select Event --</option>
                                            @if (evt != null)
                                            {
                                                <option value="@evt.Id" selected>@evt.Division | @evt.SportName - @evt.Title</option>
                                            }
                                        </select>
                                    </td>
                                    <td data-label="Role">
                                        <select name="qualifiers[@index].Role" class="form-select form-select-sm" required>
                                            @if (q.Role?.ToLower() == "athlete") { <option value="Athlete" selected>Athlete</option> } else { <option value="Athlete">Athlete</option> }
                                            @if (q.Role?.ToLower() == "coach") { <option value="Coach" selected>Coach</option> } else { <option value="Coach">Coach</option> }
                                            @if (q.Role?.Trim().Equals("Assistant Coach", StringComparison.OrdinalIgnoreCase) == true) { <option value="Assistant Coach" selected>Assistant Coach</option> } else { <option value="Assistant Coach">Assistant Coach</option> }
                                            @if (q.Role?.ToLower() == "chaperon" || q.Role?.ToLower() == "chaperone") { <option value="Chaperon" selected>Chaperon</option> } else { <option value="Chaperon">Chaperon</option> }
                                        </select>
                                    </td>
                                    <td data-label="T-Shirt Size">
                                        <select name="qualifiers[@index].TshirtSize" class="form-select form-select-sm">
                                            <option value="">-- Select --</option>
                                            @foreach (var size in tShirtSizes)
                                            {
                                                if (q.TshirtSize == size) { <option value="@size" selected>@size</option> }
                                                else { <option value="@size">@size</option> }
                                            }
                                        </select>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

<!-- Modal Form for Adding a New Participant -->
<div class="modal fade" id="qualifierModal" tabindex="-1" aria-labelledby="qualifierModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="SaveQualifierModal" method="post">
                <div class="modal-header text-white" style="background-color: var(--deped-blue, #123F2D);">
                    <h5 class="modal-title fw-bold" id="qualifierModalLabel">Add New Participant</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="Id" value="00000000-0000-0000-0000-000000000000" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Event</label>
                        <select name="EventId" id="allEventOptions" class="form-select" required>
                            <option value="">-- Choose Event --</option>
                            @foreach(var evt in eventsList)
                            {
                                <option value="@evt.Id">@evt.Division | @evt.SportName - @evt.Title</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Participant Name</label>
                        <input type="text" name="ParticipantName" class="form-control" required placeholder="Full Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Team</label>
                        <select name="Team" class="form-select">
                            <option value="">-- Select Team --</option>
                            @foreach(var t in teamsList)
                            {
                                <option value="@t.Name">@t.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Role</label>
                        <select name="Role" class="form-select" required>
                            <option value="Athlete">Athlete</option>
                            <option value="Coach">Coach</option>
                            <option value="Assistant Coach">Assistant Coach</option>
                            <option value="Chaperon">Chaperon</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">T-Shirt Size (Optional)</label>
                        <select name="TshirtSize" class="form-select">
                            <option value="">-- Select Size --</option>
                            @foreach (var size in tShirtSizes)
                            {
                                <option value="@size">@size</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white fw-bold px-4" style="background-color: var(--deped-blue);">Add Participant</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        // Expand only the event dropdown being used; untouched rows still post their selected IDs.
        function populateEventOptions(event) {
            const select = event.target.closest('.deferred-event-select');
            if (!select || select.dataset.loaded === 'true') return;
            const value = select.value;
            const options = document.getElementById('allEventOptions').cloneNode(true);
            options.options[0].textContent = '-- Select Event --';
            select.replaceChildren(...Array.from(options.childNodes));
            select.value = value;
            select.dataset.loaded = 'true';
        }
        document.addEventListener('focusin', populateEventOptions);
        document.addEventListener('pointerdown', populateEventOptions);
        document.addEventListener('keydown', populateEventOptions);

        (function checkQueryRetention() {
            try {
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.has('reset')) {
                    sessionStorage.removeItem('prov_edit_qualifiers_query');
                } else if (window.location.search && window.location.search.length > 1) {
                    sessionStorage.setItem('prov_edit_qualifiers_query', window.location.search);
                } else {
                    const savedQuery = sessionStorage.getItem('prov_edit_qualifiers_query');
                    if (savedQuery && savedQuery.length > 1) {
                        window.location.replace(window.location.pathname + savedQuery);
                    }
                }
            } catch (e) {}
        })();

        $(document).ready(function() {
            $('.select2-multi').select2({ placeholder: '-- All --', allowClear: true, width: '100%', multiple: true });
        });

        function toggleSelectAll(source) {
            checkboxes = document.querySelectorAll('.row-checkbox');
            for(let i=0, n=checkboxes.length;i<n;i++) {
                checkboxes[i].checked = source.checked;
            }
        }
    </script>
}
