@section Scripts {
<script src="~/js/meet-hero-fit.js" asp-append-version="true" defer></script>
<script>
    function toggleTop3(division, btnElement) {
        // Update active button styling
        $('.division-filters .filter-btn').removeClass('active-filter');
        if (btnElement) {
            $(btnElement).addClass('active-filter');
        } else {
            $('.division-filters .filter-btn').each(function() {
                if ($(this).text().trim().toLowerCase() === division.toLowerCase()) {
                    $(this).addClass('active-filter');
                }
            });
        }

        // Toggle the specific Top 3 views
        $('.top3-view').stop(true, true).hide();
        $('#top3-' + division).fadeIn(200);

        try {
            sessionStorage.setItem('prov_home_top3_division', division);
        } catch (e) {}
    }

    function loadTop3Filter() {
        try {
            const saved = sessionStorage.getItem('prov_home_top3_division');
            const division = ['Overall', 'Secondary', 'Elementary', 'Paragames']
                .find(value => value.toLowerCase() === saved?.toLowerCase());
            if (division) {
                toggleTop3(division);
            }
        } catch (e) {}
    }

    // Vanilla Javascript for Real-Time Timer
    document.addEventListener("DOMContentLoaded", function () {
        loadTop3Filter();
        const timerElement = document.getElementById('countdown-timer');
        const labelElement = document.getElementById('countdown-label');
        
        if (timerElement && Number(timerElement.getAttribute('data-target')) > 0) {
            const targetDateStr = timerElement.getAttribute('data-target');
            const targetDate = parseInt(targetDateStr, 10);
            
            function updateCountdown() {
                const now = new Date().getTime();
                const distance = targetDate - now;

                if (distance > 86400000) { // More than 24 hours
                    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                    if (labelElement) labelElement.style.display = "none";
                    const number = document.createElement('span');
                    number.className = 'poster-days';
                    number.textContent = days;
                    const caption = document.createElement('span');
                    caption.className = 'poster-days-caption';
                    caption.append(days > 1 ? 'DAYS' : 'DAY', document.createElement('br'), 'TO GO');
                    timerElement.replaceChildren(number, caption);
                } 
                else if (distance > 0 && distance <= 86400000) { // Less than 24 hours (Real-time ticking)
                    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                    
                    if (labelElement) labelElement.style.display = "block";
                    timerElement.innerText = `${hours}h ${minutes}m ${seconds}s`;
                } 
                else if (distance <= 0 && distance > -86400000) { // The day of the event
                    if (labelElement) labelElement.style.display = "none";
                    timerElement.innerText = "TODAY";
                } 
                else { // After the event has passed
                    if (labelElement) labelElement.style.display = "none";
                    timerElement.innerText = "EVENT STARTED";
                }
            }
            
            // Execute immediately to prevent flicker, then tick every second live
            updateCountdown(); 
            setInterval(updateCountdown, 1000);
        }
    });

    // jQuery for Swapping Slider
    $(document).ready(function () {
        let currentSlide = 0;
        const slides = $('.leader-slide');
        
        if (slides.length > 1) {
            setInterval(function () {
                $(slides[currentSlide]).fadeOut(300, function () {
                    currentSlide = (currentSlide + 1) % slides.length;
                    $(slides[currentSlide]).fadeIn(300);
                });
            }, 3000);
        }
    });
</script>
}
