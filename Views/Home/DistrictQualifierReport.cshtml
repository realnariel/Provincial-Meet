    .cert-text { font-size: 0.8rem; line-height: 1.4; color: #000000; margin-bottom: 15px; text-align: justify; }
    
    .setup-card {
        background-color: #ffffff;
        border: 1px solid rgba(0, 51, 160, 0.15);
        border-top: 4px solid #123F2D;
