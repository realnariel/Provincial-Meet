@using ProvMeet.Services
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.RegularExpressions
@inject ProvMeet.Data.ApplicationDbContext DbContext
@model IEnumerable<ProvMeet.Models.EventQualifier>
@{
    ViewData["Title"] = "Regional Qualifier Report";
    var reportTimestamp = DateTime.UtcNow.AddHours(8).ToString("MMMM dd, yyyy h:mm tt", System.Globalization.CultureInfo.InvariantCulture);
    
    var allDbEvents = DbContext.Events.ToList();
    var selectedSports = (Context.Request.Query["sportsName"].ToString() ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var selectedEvents = (Context.Request.Query["eventId"].ToString() ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var selectedDivisions = (Context.Request.Query["division"].ToString() ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var selectedDistricts = (Context.Request.Query["district"].ToString() ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();

    var titleFilters = new List<string>();
    if (selectedSports.Any()) titleFilters.Add(string.Join(", ", selectedSports));
    if (selectedDistricts.Any()) titleFilters.Add(string.Join(", ", selectedDistricts));
    if (selectedDivisions.Any()) titleFilters.Add(string.Join(", ", selectedDivisions));
    if (selectedEvents.Any()) titleFilters.Add(string.Join(", ", allDbEvents.Where(e => selectedEvents.Contains(e.Id.ToString())).Select(e => e.Title)));
    string selectedSportsText = titleFilters.Any() ? string.Join(" - ", titleFilters).ToUpperInvariant() : "OVERALL";
    // Helper lambda to determine division
    string GetEventDivision(ProvMeet.Models.Event evt) {
        if (evt == null) return "";
        string div = "";
        var prop = evt.GetType().GetProperty("Division");
        if (prop != null) {
            div = (prop.GetValue(evt) as string)?.ToUpper() ?? "";
        } else if (evt.Title != null) {
            if (evt.Title.IndexOf("ELEM", StringComparison.OrdinalIgnoreCase) >= 0) div = "ELEMENTARY";
            else if (evt.Title.IndexOf("SEC", StringComparison.OrdinalIgnoreCase) >= 0) div = "SECONDARY";
        }
        return div;
    }

    // Helper method to convert names to Proper Case (Title Case)
    string ToProperCase(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return text;
        var textInfo = new System.Globalization.CultureInfo("en-US", false).TextInfo;
        return textInfo.ToTitleCase(text.ToLower());
    }

    // Identical sorting sequence to the District Qualifier Report view
    var reportQualifiers = Model?
        .OrderBy(q => {
            var evt = allDbEvents.FirstOrDefault(e => e.Id == q.EventId);
            string div = evt != null ? GetEventDivision(evt) : "";
            if (div.Contains("ELEM")) return 1;
            if (div.Contains("SEC")) return 2;
            return 3;
        })
        .ThenBy(q => {
            var evt = allDbEvents.FirstOrDefault(e => e.Id == q.EventId);
            return evt?.SportName ?? "";
        })
        .ThenBy(q => {
            var evt = allDbEvents.FirstOrDefault(e => e.Id == q.EventId);
            string sport = evt?.SportName?.Trim() ?? "";
            string title = evt?.Title?.ToLower() ?? "";

            if (sport.Equals("Arnis", StringComparison.OrdinalIgnoreCase))
            {
                int anyoOrder = title.Contains("anyo") ? 1 : 2;
                int genderOrder = 3;
                if (Regex.IsMatch(title, @"\b(girls?|women'?s?)\b")) genderOrder = 1;
                else if (Regex.IsMatch(title, @"\b(boys?|men'?s?)\b")) genderOrder = 2;
                
                return anyoOrder * 10 + genderOrder;
            }

            if (sport.Equals("Gymnastics", StringComparison.OrdinalIgnoreCase))
            {
                int disciplineOrder = title.Contains("aerobic") ? 1 : 2;
                int genderOrder = 3;
                if (Regex.IsMatch(title, @"\b(girls?|women'?s?)\b")) genderOrder = 1;
                else if (Regex.IsMatch(title, @"\b(boys?|men'?s?)\b")) genderOrder = 2;
                
                return disciplineOrder * 10 + genderOrder;
            }

            if (Regex.IsMatch(title, @"\b(girls?|women'?s?)\b")) return 1;
            if (Regex.IsMatch(title, @"\b(boys?|men'?s?)\b")) return 2;
            return 3; 
        })
        .ThenBy(q => {
            var evt = allDbEvents.FirstOrDefault(e => e.Id == q.EventId);
            return evt?.Title ?? "";
        })
        .ThenBy(q => {
            string r = q.Role?.ToLower() ?? "";
            if (r.Contains("athlete")) return 1;
            if (r.Contains("assistant coach")) return 3;
            if (r.Contains("coach")) return 2;
            if (r.Contains("chaperon") || r.Contains("chaperone")) return 4;
            return 5;
        })
        .ThenBy(q => {
            var evt = allDbEvents.FirstOrDefault(e => e.Id == q.EventId);
            if (evt != null && !string.IsNullOrEmpty(q.ParticipantName)) {
                if (!string.IsNullOrEmpty(evt.GoldWinnerName) && evt.GoldWinnerName.Contains(q.ParticipantName)) return 1;
                if (!string.IsNullOrEmpty(evt.SilverWinnerName) && evt.SilverWinnerName.Contains(q.ParticipantName)) return 2;
                if (!string.IsNullOrEmpty(evt.BronzeWinnerName) && evt.BronzeWinnerName.Contains(q.ParticipantName)) return 3;
            }
            return 4;
        })
        .ToList() ?? new List<ProvMeet.Models.EventQualifier>();

    ProvMeet.Models.Event? GetEvent(int eventId)
    {
        return allDbEvents.FirstOrDefault(e => e.Id == eventId);
    }

    var globalTshirtSizes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var q in reportQualifiers)
    {
        string pName = q.ParticipantName?.Trim() ?? "";
        string dName = q.Team?.Trim() ?? "";
        string tSize = q.TshirtSize?.Trim() ?? "";
        
        if (!string.IsNullOrEmpty(pName) && !string.IsNullOrEmpty(tSize) && !tSize.Equals("N/A", StringComparison.OrdinalIgnoreCase))
        {
            string key = $"{pName}_{dName}";
            if (!globalTshirtSizes.ContainsKey(key))
            {
                globalTshirtSizes[key] = tSize;
            }
        }
    }

    int uniqueQualifiersCount = reportQualifiers
        .Where(q => !string.IsNullOrWhiteSpace(q.ParticipantName))
        .Select(q => $"{q.ParticipantName?.Trim().ToLower()}_{q.Team?.Trim().ToLower()}")
        .Distinct()
        .Count();

    string PersonKey(ProvMeet.Models.EventQualifier q) => $"{q.ParticipantName?.Trim().ToUpperInvariant()}|{q.Team?.Trim().ToUpperInvariant()}";
    int CountPeople(IEnumerable<ProvMeet.Models.EventQualifier> people) => people
        .Where(q => !string.IsNullOrWhiteSpace(q.ParticipantName)).Select(PersonKey).Distinct().Count();
    string SummaryRole(string? role) {
        var value = (role ?? "").Trim().ToLowerInvariant();
        if (value.Contains("athlete")) return "Athletes";
        if (value.Contains("assistant") && value.Contains("coach")) return "Assistant Coaches";
        if (value.Contains("coach")) return "Coaches";
        if (value.Contains("chaperon")) return "Chaperones";
        return "Other / Unspecified";
    }
    var summaryPeople = reportQualifiers.Where(q => !string.IsNullOrWhiteSpace(q.ParticipantName))
        .GroupBy(PersonKey).Select(g => g.First()).ToList();
    var summaryCounts = new[] { "Athletes", "Coaches", "Assistant Coaches", "Chaperones", "Other / Unspecified" }
        .Select(role => new { Role = role, Count = summaryPeople.Count(q => SummaryRole(q.Role) == role) })
        .Where(item => item.Role != "Other / Unspecified" || item.Count > 0).ToList();

    string ParticipantGroup(ProvMeet.Models.EventQualifier qualifier) {
        var evt = GetEvent(qualifier.EventId);
        if (evt != null && PlayerMedals.Category(evt) != "Unspecified") return PlayerMedals.Category(evt);
        var title = evt?.Title ?? "";
        bool boys = Regex.IsMatch(title, @"\bboys?\b", RegexOptions.IgnoreCase);
        bool girls = Regex.IsMatch(title, @"\bgirls?\b", RegexOptions.IgnoreCase);
        return boys && !girls ? "Boys" : girls && !boys ? "Girls" : "Mixed";
    }

    void RenderSummary(string id) {
        <section class="participant-summary">
            <h5 class="section-subtitle">SUMMARY</h5>
            <table class="table-report" id="@id">
                <thead><tr><th>Participant Category</th><th class="text-center" style="width: 20%;">Count</th></tr></thead>
                <tbody>
                    @foreach (var item in summaryCounts) {
                        <tr><td>@item.Role</td><td class="text-center">@item.Count</td></tr>
                    }
                    <tr><td><strong>Total</strong></td><td class="text-center"><strong>@summaryPeople.Count</strong></td></tr>
                </tbody>
            </table>
        </section>
    }
    // ==========================================
    // LOGIC FOR DISTRICT QUALIFIER REPORT
    // ==========================================
    string lastRenderedSport = "";
    string lastRenderedEvent = "";
    HashSet<string> seenParticipantsForTshirt = new HashSet<string>();

    void ResetTracker()
    {
        lastRenderedSport = "";
        lastRenderedEvent = "";
    }

    void RenderQualifierRow(ProvMeet.Models.EventQualifier qualifier)
    {
        var evt = GetEvent(qualifier.EventId);
        string sportName = evt?.SportName ?? "N/A";
        string eventTitle = evt?.Title ?? "N/A";
        string div = evt != null ? GetEventDivision(evt) : "";
        
        string roleDisplay = !string.IsNullOrEmpty(qualifier.Role) 
            ? char.ToUpper(qualifier.Role.First()) + qualifier.Role.Substring(1).ToLower() 
            : "N/A";

        string displaySport = sportName == lastRenderedSport ? "" : sportName;
        string displayEvent = eventTitle == lastRenderedEvent ? "" : eventTitle;

        lastRenderedSport = sportName;
        lastRenderedEvent = eventTitle;

        string pNameKey = qualifier.ParticipantName?.Trim() ?? "";
        string dNameKey = qualifier.Team?.Trim() ?? "";
        string globalKey = $"{pNameKey}_{dNameKey}";
        string bestTshirtSize = globalTshirtSizes.ContainsKey(globalKey) ? globalTshirtSizes[globalKey] : "N/A";

        string globalParticipantKey = $"{qualifier.ParticipantName?.Trim().ToLower()}_{qualifier.Team?.Trim().ToLower()}";
        bool isDuplicateTshirt = !seenParticipantsForTshirt.Add(globalParticipantKey);

        string tShirtDisplay = isDuplicateTshirt ? "-" : bestTshirtSize;

        <tr>
            <td class="text-start">
                @* Sport name and total are shown once in the sport heading. *@
            </td>
            <td class="text-start"><div class="event-title-clamp">@displayEvent</div></td>
            <td class="text-start"><strong>@(string.IsNullOrEmpty(qualifier.ParticipantName) ? "N/A" : ToProperCase(qualifier.ParticipantName))</strong></td>
            <td class="text-start">@(string.IsNullOrEmpty(qualifier.Team) ? "N/A" : qualifier.Team)</td>
            <td class="text-center">@roleDisplay</td>
            <td class="text-center">@tShirtDisplay</td>
            <td></td>
        </tr>
    }

    // ==========================================
    // LOGIC FOR PARTICIPANT LIST
    // ==========================================
    string lastRenderedSport_PL = "";
    HashSet<string> seenParticipantsForList = new HashSet<string>();
    HashSet<string> seenParticipantsForTshirt_PL = new HashSet<string>();

    void ResetTracker_PL()
    {
        lastRenderedSport_PL = "";
        seenParticipantsForList.Clear();
    }

    void RenderParticipantRow(ProvMeet.Models.EventQualifier qualifier)
    {
        var evt = GetEvent(qualifier.EventId);
        string sportName = evt?.SportName ?? "N/A";
        string div = evt != null ? GetEventDivision(evt) : "";
        
        string categoryKey = ParticipantRoles.Order(qualifier.Role) == 0 ? ParticipantGroup(qualifier) : "Staff";
        string eventParticipantKey = $"{div}_{sportName}_{categoryKey}_{qualifier.ParticipantName?.Trim().ToLower()}_{qualifier.Team?.Trim().ToLower()}_{qualifier.Role?.Trim().ToLower()}";
        if (!seenParticipantsForList.Add(eventParticipantKey)) return; 

        string roleDisplay = !string.IsNullOrEmpty(qualifier.Role) 
            ? char.ToUpper(qualifier.Role.First()) + qualifier.Role.Substring(1).ToLower() 
            : "N/A";

        string displaySport = sportName == lastRenderedSport_PL ? "" : sportName;
        lastRenderedSport_PL = sportName;

        string pNameKey = qualifier.ParticipantName?.Trim() ?? "";
        string dNameKey = qualifier.Team?.Trim() ?? "";
        string globalKey = $"{pNameKey}_{dNameKey}";
        string bestTshirtSize = globalTshirtSizes.ContainsKey(globalKey) ? globalTshirtSizes[globalKey] : "N/A";

        string globalParticipantKey = $"{qualifier.ParticipantName?.Trim().ToLower()}_{qualifier.Team?.Trim().ToLower()}";
        bool isDuplicateTshirt = !seenParticipantsForTshirt_PL.Add(globalParticipantKey);
        string tShirtDisplay = isDuplicateTshirt ? "-" : bestTshirtSize;

        <tr>
            <td class="text-start">
                @* Sport name and total are shown once in the sport heading. *@
            </td>
            <td class="text-start"><strong>@(string.IsNullOrEmpty(qualifier.ParticipantName) ? "N/A" : ToProperCase(qualifier.ParticipantName))</strong></td>
            <td class="text-start">@(string.IsNullOrEmpty(qualifier.Team) ? "N/A" : qualifier.Team)</td>
            <td class="text-center">@roleDisplay</td>
            <td class="text-center">@tShirtDisplay</td>
            <td></td>
        </tr>
    }
}

