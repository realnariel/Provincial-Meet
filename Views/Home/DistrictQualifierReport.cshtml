        .table-report th { background-color: #f2f2f2 !important; color: #000000 !important; border-bottom: 2px solid #000000 !important; padding: 4px 6px !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .table-report td { color: #000000 !important; border-bottom: 1px solid #cccccc !important; padding: 4px 6px !important; }
