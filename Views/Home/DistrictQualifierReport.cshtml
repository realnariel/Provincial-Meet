        size: 8.5in 13in portrait;
        margin: 0.4in !important; 
    }

    @@media print {
        header, footer, nav, .d-print-none, #setup-section { display: none !important; }
        html, body, main { background-color: #ffffff !important; margin: 0 !important; padding: 0 !important; color: #000000 !important; width: 100% !important; height: auto !important; overflow: visible !important; }
        .container, .container-fluid, .pb-3, #report-section, #participant-section { width: 100% !important; max-width: 100% !important; padding: 0 !important; margin: 0 auto !important; }

        .report-wrapper {
            display: block !important; 
            position: static !important;
            width: 100% !important; 
            max-width: 100% !important;
            margin: 0 auto !important; 
            padding: 0 !important;
            box-shadow: none !important;
        }

        .report-divider { border-top: 1.5px solid #000000 !important; margin: 8px 0 !important; }
        .meta-col { border-right: 1px solid #cccccc !important; width: 50%; display: inline-block; vertical-align: top; }
        .meta-label { color: #000000 !important; font-size: 0.62rem !important; }
