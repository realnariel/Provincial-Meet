@{
    ViewData["Title"] = "Coordinator Sign In";
}

<style>
    /* ========================================== */
    /* MASTER OPACITY & COLOR CONTROL             */
    :root {
        --card-opacity: 1.0; 
    }
    /* ========================================== */

    body {
        background-color: var(--cc-background) !important; 
    }

    /* Animated Gradient Core Setup */
    @@keyframes gradientMove {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .login-card {
        background: #ffffff !important;
        border: 1px solid rgba(18, 63, 45, 0.12) !important;
        box-shadow: 0 10px 30px rgba(18, 63, 45, 0.1) !important;
        border-top: 5px solid var(--cc-gold, #C8A354) !important;
        border-radius: var(--cc-radius-lg, 14px);
        padding: 2.5rem;
    }

    .form-control-custom {
        border: 1px solid var(--cc-border, #D9DEE5);
        border-radius: 6px;
        padding: 0.75rem 1rem;
        font-family: var(--font-body, 'Inter', sans-serif);
    }

    .form-control-custom:focus {
        border-color: var(--cc-primary, #123F2D);
        box-shadow: 0 0 0 0.2rem rgba(18, 63, 45, 0.15);
    }

    .btn-login-submit {
        background: linear-gradient(135deg, var(--cc-primary, #123F2D) 0%, var(--cc-secondary, #397447) 100%);
        border: none;
        color: white;
        font-weight: 700;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(18, 63, 45, 0.2);
    }

    .btn-login-submit:hover {
        opacity: 0.95;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(57, 116, 71, 0.3);
        color: white;
    }
</style>

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-5">
            
            <!-- Standardized Login Card -->
            <div class="login-card">
                <div class="text-center mb-4">
                    <h2 class="fw-bold" style="font-family: var(--font-body); color: var(--cc-primary, #123F2D);">
                        <i class="bi bi-shield-lock-fill" style="color: var(--cc-gold, #C8A354);"></i> LOGIN
                    </h2>
                    <p class="text-muted fw-bold" style="font-size: 0.9rem; font-family: var(--font-body);">Bohol Provincial Athletic Meet 2026 Management Console</p>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success py-2 px-3 border-0 rounded mb-3 fw-bold" style="font-size: 0.85rem;">
                        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 px-3 border-0 rounded mb-3 fw-bold" style="font-size: 0.85rem;">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Username</label>
                        <input type="text" name="username" class="form-control form-control-custom" placeholder="Enter username" required autocomplete="username" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Password</label>
                        <input type="password" name="password" class="form-control form-control-custom" placeholder="••••••••" required autocomplete="current-password" />
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-login-submit w-100 mb-2">
                        <span>Access Dashboard</span>
                    </button>
                    
                    <!-- Reset Password Prompt Button -->
                    <button type="button" class="btn btn-light border w-100 fw-bold text-muted" style="font-size: 0.9rem; border-radius: 6px;" onclick="alert('Please contact the System Administrator to request a password reset.');">
                        <i class="bi bi-key-fill me-1"></i> Forgot Password?
                    </button>
                </form>
            </div>
            
            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-bold" style="font-size: 0.85rem; font-family: var(--font-body);">
                    <i class="bi bi-house-door"></i> Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>
