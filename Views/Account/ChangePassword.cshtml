@{
    ViewData["Title"] = "Update Password Required";
}

<style>
    /* ========================================== */
    /* MASTER OPACITY & COLOR CONTROL             */
    :root {
        --card-opacity: 1.0; 
    }
    /* ========================================== */

    body {
        background-color: var(--cc-background) !important; 
    }

    .change-password-card {
        background: #ffffff !important;
        border: 1px solid rgba(18, 63, 45, 0.12) !important;
        box-shadow: 0 10px 30px rgba(18, 63, 45, 0.1) !important;
        border-top: 5px solid var(--cc-gold, #C8A354) !important;
        border-radius: var(--cc-radius-lg, 14px);
        padding: 2.5rem;
    }

    .form-control-custom {
        border: 1px solid var(--cc-border, #D9DEE5);
        border-radius: 6px;
        padding: 0.75rem 1rem;
        font-family: var(--font-body, 'Inter', sans-serif);
    }

    .form-control-custom:focus {
        border-color: var(--cc-primary, #123F2D);
        box-shadow: 0 0 0 0.2rem rgba(18, 63, 45, 0.15);
    }

    .btn-custom-submit {
        background: linear-gradient(135deg, var(--cc-primary, #123F2D) 0%, var(--cc-secondary, #397447) 100%);
        border: none;
        color: white;
        font-weight: 700;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(18, 63, 45, 0.2);
    }

    .btn-custom-submit:hover {
        opacity: 0.95;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(57, 116, 71, 0.3);
        color: white;
    }
</style>

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-5">
            
            <div class="change-password-card">
                <div class="text-center mb-4">
                    <h2 class="fw-bold" style="font-family: var(--font-body); color: var(--cc-primary, #123F2D);">
                        <i class="bi bi-key-fill text-warning"></i> ACTION REQUIRED
                    </h2>
                    <p class="text-muted fw-bold" style="font-size: 0.9rem; font-family: var(--font-body);">
                        For your security, you must update your default password before accessing the dashboard.
                    </p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 px-3 border-0 rounded mb-3 fw-bold" style="font-size: 0.85rem;">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">New Password</label>
                        <input type="password" name="newPassword" class="form-control form-control-custom" placeholder="Enter new password" required autocomplete="new-password" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Confirm Password</label>
                        <input type="password" name="confirmPassword" class="form-control form-control-custom" placeholder="Re-type new password" required autocomplete="new-password" />
                    </div>

                    <button type="submit" class="btn btn-custom-submit w-100">
                        <span>Update Password</span>
                    </button>
                </form>
            </div>
            
        </div>
    </div>
</div>