@model ProvMeet.Models.Coordinator
@{
    ViewData["Title"] = "Edit Coordinator";
}

<style>
    /* ========================================== */
    /* MASTER OPACITY & COLOR CONTROL             */
    :root {
        --card-opacity: 1.0; 
    }
    /* ========================================== */

    body {
        background-color: var(--cc-background) !important; 
    }

    /* Animated Gradient Core Setup */
    @@keyframes gradientMove {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .form-card {
        background: white;
        border-radius: var(--cc-radius-lg, 14px);
        box-shadow: 0 10px 30px rgba(18, 63, 45, 0.08);
        border: 1px solid rgba(18, 63, 45, 0.15);
        border-top: 5px solid var(--cc-gold, #C8A354);
    }
    
    .form-control-custom {
        border: 1px solid var(--cc-border, #D9DEE5);
        border-radius: 6px;
        padding: 0.75rem 1rem;
        font-family: var(--font-body, 'Inter', sans-serif);
    }

    .form-control-custom:focus {
        border-color: var(--cc-primary, #123F2D);
        box-shadow: 0 0 0 0.2rem rgba(18, 63, 45, 0.15);
    }

    /* Styles to seamlessly integrate the custom input with the button */
    .input-group > .form-control-custom {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }
    
    .input-group > .btn-reset {
        border-top-right-radius: 6px;
        border-bottom-right-radius: 6px;
        border: 1px solid var(--cc-border, #D9DEE5);
        border-left: none;
        background-color: #f8f9fa;
        color: var(--cc-primary, #123F2D);
        font-weight: 600;
        transition: all 0.2s ease-in-out;
        font-family: var(--font-body, 'Inter', sans-serif);
    }
    
    .input-group > .btn-reset:hover {
        background-color: #e9ecef;
        color: var(--cc-primary-dark, #092D20);
    }

    .btn-submit-custom {
        background: linear-gradient(135deg, var(--cc-primary, #123F2D) 0%, var(--cc-secondary, #397447) 100%);
        border: none;
        color: white;
        font-weight: 700;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(18, 63, 45, 0.2);
        font-family: var(--font-body, 'Inter', sans-serif);
    }

    .btn-submit-custom:hover {
        opacity: 0.95;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(57, 116, 71, 0.3);
        color: white;
    }

    .btn-cancel-custom {
        border: 1px solid var(--cc-border, #D9DEE5);
        color: var(--cc-primary, #123F2D);
        background: #ffffff;
        font-weight: 700;
        padding: 0.75rem 1.25rem;
        border-radius: 6px;
        transition: all 0.25s ease;
        font-family: var(--font-body, 'Inter', sans-serif);
    }

    .btn-cancel-custom:hover {
        background: rgba(18, 63, 45, 0.04);
        color: var(--cc-primary, #123F2D);
        border-color: var(--cc-primary, #123F2D);
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card p-4 p-md-5">
                <h3 class="fw-bold mb-4" style="font-family: var(--font-body); color: var(--cc-primary, #123F2D);">
                    <i class="bi bi-pencil-square text-warning me-2"></i>MODIFY CREDENTIALS
                </h3>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Full Name</label>
                        <input asp-for="FullName" class="form-control form-control-custom" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Username</label>
                        <input asp-for="Username" class="form-control form-control-custom" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Update Password</label>
                        <div class="input-group">
                            <input name="Password" type="password" id="PasswordInput" class="form-control form-control-custom" placeholder="Leave blank to keep current password" autocomplete="new-password" maxlength="100" />
                            <button class="btn btn-reset px-3" type="button" onclick="resetPassword()" title="Reset to Default Password">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                            </button>
                        </div>
                        <small class="text-muted mt-1 d-block" style="font-family: var(--font-body);">
                            <i class="bi bi-info-circle me-1"></i> Click reset to change the password to the default ("coordinator").
                        </small>
                    </div>

                    <div class="mb-4 p-3 bg-light rounded border d-flex align-items-center gap-3">
                        <input asp-for="IsAdmin" class="form-check-input ms-0" type="checkbox" id="isAdminSwitch" style="transform: scale(1.2);">
                        <label class="form-check-label fw-bold text-dark" for="isAdminSwitch" style="font-size: 0.9rem; font-family: var(--font-body);">Global Administrator Access</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-submit-custom flex-grow-1"><span>Update Changes</span></button>
                        <a asp-action="Index" class="btn btn-cancel-custom px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function resetPassword() {
            // Prompts the user to ensure they want to reset the password
            if (confirm("Are you sure you want to reset this user's password to the default ('coordinator')?")) {
                document.getElementById("PasswordInput").value = "coordinator";
            }
        }
    </script>
}
